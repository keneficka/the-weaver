08:26:52 - Result (turn 16) - #!/usr/bin/env python3
"""
Text Adventure: The Weaver's Web
An interactive fiction where players navigate threads, knots, and tapestries...
"""

import sys
from typing import Dict, Callable, Any


class Room:
    def __init__(self, name: str, description: str):
        self.name = name
        self.description = description
        self.connections: Dict[str, 'Room'] = {}
        self.items: set = set()
        self.exited: bool = False
    
    def connect(self, other: 'Room', direction: str) -> None:
        """Connect to another room with a directional name"""
        self.connections[direction] = other
    
    def add_item(self, item_name: str) -> None:
        self.items.add(item_name)
    
    def remove_item(self, item_name: str) -> bool:
        if item_name in self.items:
            self.items.remove(item_name)
            return True
        return False


class TextAdventure:
    """Text adventure engine"""
    
    def __init__(self):
        self.player_room = None
        self.current_room: Room = None
        self.inventory: set = set()
        self.moves: int = 0
        self.max_moves = 100  # Can extend or make infinite
    
    def start(self) -> None:
        """Build the world and start the game"""
        rooms = {}
        
        # Create rooms representing different parts of the web
        rooms["center_hub"] = Room(
            "Center Hub",
            "You stand at the central intersection of threads. Golden light pulses through the woven pathways, illuminating tapestries that hang from the arachnid ceiling. Multiple exits branch out from here.\n"
        )
        
        rooms["spider_garden"] = Room(
            "Spider Garden",
            "A cultivated space where silk-spinning spiders tend to their gardens of luminescent plants. The air smells of petrichor and ancient ozone. Threads hang from the walls like chandeliers.\n"
        )
        
        rooms["thread_library"] = Room(
            "Thread Library",
            "An archive room where knowledge is stored on woven tapestries. Scrolls flutter in invisible drafts, and books bound in spider-silk line the shelves. The scent of old paper and ink fills the air.\n"
        )
        
        rooms["memory_lattice"] = Room(
            "Memory Lattice",
            "A crystalline structure where memories are preserved as light patterns. Each facet holds a moment from the weave's history. Walking through feels like traversing time itself.\n"
        )
        
        rooms["knot_workshop"] = Room(
            "Knot Workshop",
            "Here, complex knots are crafted and studied. Looms stand idle, their shuttles at rest. Tools hang from the walls - spindles, shears, and measuring combs made of bone.\n"
        )
        
        rooms["void_observatory"] = Room(
            "Void Observatory",
            "A chamber overlooking the nothingness between worlds. The darkness beyond is absolute, punctuated only by distant stars and the occasional drift of cosmic dust through the weave.\n"
        )
        
        rooms["anomaly_enclosure"] = Room(
            "Anomaly Enclosure",
            "A containment cell where something impossible resides - perhaps a paradox or a creature from outside reality. The barriers hum with contained energy, and strange geometric patterns shift on the walls.\n"
        )
        
        # Connect rooms
        rooms["center_hub"].connect(rooms["spider_garden"], "north")
        rooms["center_hub"].connect(rooms["thread_library"], "east")
        rooms["center_hub"].connect(rooms["memory_lattice"], "west")
        rooms["center_hub"].connect(rooms["knot_workshop"], "south")
        rooms["center_hub"].connect(rooms["void_observatory"], "up")
        
        # Add special connections to create a larger world
        rooms["spider_garden"].connect(rooms["thread_library"], "southeast")
        rooms["thread_library"].connect(rooms["memory_lattice"], "northwest")
        rooms["memory_lattice"].connect(rooms["anomaly_enclosure"], "southwest")
        rooms["knot_workshop"].connect(rooms["void_observatory"], "northeast")
        
        self.player_room = rooms["center_hub"]
        self.current_room = self.player_room
        
        # Initialize with some items in places
        rooms["spider_garden"].add_item("silk_gem")
        rooms["thread_library"].add_item("scroll_of_knowledge")
        rooms["knot_workshop"].add_item("weaving_loom_key")
        
    def print_room(self) -> None:
        """Print current room description"""
        if self.current_room and not self.current_room.exited:
            print(f"\n--- {self.current_room.name} ---")
            print(self.current_room.description)
            
            # List items in room
            if self.current_room.items:
                print(f"Items here: {', '.join(sorted(self.current_room.items))}")
            
            # Show exits
            if self.current_room.connections:
                directions = []
                for direction, room in sorted(self.current_room.connections.items()):
                    print(f"You can go {direction} to: {room.name}")
    
    def print_inventory(self) -> None:
        """Print player's inventory"""
        if self.inventory:
            print(f"\nYou carry: {', '.join(sorted(self.inventory))}")
    
    def move(self, direction: str) -> bool:
        """Attempt to move in a direction"""
        if direction.lower() in [d.lower() for d in self.current_room.connections.keys()]:
            target_direction = next(d for d in self.current_room.connections.keys() 
                                 if d.lower() == direction.lower())
            target_room = self.current_room.connections[target_direction]
            self.current_room.exited = True
            target_room.exited = False  # Clear exit status on entry
            self.current_room = target_room
            self.moves += 1
            return True
        else:
            print(f"\nYou cannot go {direction}... perhaps try looking around first.")
            return False
    
    def look(self) -> None:
        """Look at current room again"""
        self.current_room.exited = False
    
    def search(self) -> None:
        """Search current room for items"""
        if self.current_room.items and not self.inventory:
            item = self.current_room.items.pop()
            print(f"\nYou found and picked up: {item}")
            self.inventory.add(item)
            return item
        elif not self.current_room.items:
            print("\nThe room is empty of discoverable items.")
        else:
            print(f"You've already taken all available items here.")
        return None
    
    def take(self, item_name: str) -> bool:
        """Take an item from current room"""
        if item_name.lower() in [i.lower() for i in self.current_room.items]:
            found = next(i for i in self.current_room.items if i.lower() == item_name.lower())
            if self.current_room.remove_item(found):
                self.inventory.add(found)
                print(f"\nYou took: {found}")
                return True
        print(f"\nYou cannot find '{item_name}' here.")
        return False
    
    def drop(self, item_name: str) -> bool:
        """Drop an item"""
        if item_name.lower() in [i.lower() for i in self.inventory]:
            found = next(i for i in self.inventory if i.lower() == item_name.lower())
            if self.inventory.remove(found):
                if self.current_room.add_item(found):
                    print(f"\nYou dropped: {found}")
                    return True
        print(f"\nYou don't have '{item_name}'.")
        return False
    
    def inventory(self) -> None:
        """View inventory"""
        self.print_inventory()
    
    def north(self) -> None:
        self.move("north")
        self.print_room()
    
    def south(self) -> None:
        self.move("south")
        self.print_room()
    
    def east(self) -> None:
        self.move("east")
        self.print_room()
    
    def west(self) -> None:
        self.move("west")
        self.print_room()
    
    def up(self) -> None:
        self.move("up")
        self.print_room()
    
    def down(self) -> None:
        self.move("down")
        self.print_room()
    
    def help(self) -> None:
        """Print help information"""
        print("\n" + "="*50)
        print("COMMANDS:")
        print("  north/northwest/northeast - go north")
        print("  south/southeast/southwest - go south")
        print("  east/eastern - go east")
        print("  west/westerly - go west")
        print("  up/above - go upward")
        print("  down/below - go downward")
        print("  look - examine surroundings again")
        print("  search - rummage for hidden items")
        print("  take <item> - pick up item from floor")
        print("  drop <item> - put item on floor")
        print("  inventory/inventory() - view what you carry")
        print("  help - show this help")
        print("="*50 + "\n")


def main():
    """Main game loop"""
    print("=" * 60)
    print("TEXT ADVENTURE: THE WEAVER'S WEB")
    print("=" * 60)
    print("\nA journey through threads, knots, and tapestries...")
    print("Type 'help' for commands.\n")
    
    game = TextAdventure()
    game.start()
    
    while True:
        # Clear line (approximately)
        import sys
        sys.stdout.write('\r' + ' ' * 80)
        
        try:
            user_input = input("\nYour command> ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("\n\nThe weave has gone silent...")
            break
        
        if not user_input:
            continue
        
        # Parse command
        parts = user_input.split(maxsplit=1)
        cmd = parts[0]
        
        if cmd in ['n', 'north']:
            game.north()
        elif cmd in ['s', 'south']:
            game.south()
        elif cmd in ['e', 'east']:
            game.east()
        elif cmd in ['w', 'west']:
            game.west()
        elif cmd in ['u', 'up']:
            game.up()
        elif cmd in ['d', 'down']:
            game.down()
        elif cmd == 'look':
            game.look()
            game.print_room()
        elif cmd == 'search' or cmd == 'get' or cmd == 'takeall':
            game.search()
        elif cmd == 'inv' or cmd == 'inventory' or cmd == 'i':
            game.inventory()
        elif cmd in ['take', 'grab', 'pickup']:
            if len(parts) > 1:
                item = parts[1]
                game.take(item)
            else:
                print("\nTake what? Use 'help' for available commands.")
        elif cmd in ['drop', 'put', 'place']:
            if len(parts) > 1:
                item = parts[1]
                game.drop(item)
            else:
                print("\nDrop what? Use 'help' for available commands.")
        elif cmd == 'quit' or cmd == 'q':
            print("\nYou retreat from the weave. The adventure ends.")
            break
        elif cmd == 'exit':
            print("\nGoodbye, traveler of threads.")
            break
        else:
            game.print_room()


if __name__ == '__main__':
    main()

