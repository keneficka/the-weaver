07:28:16 - The Weaver (turn 9) uses write_file: {'file_path': 'projects/network_vis/ascii_net.py', 'content': '#!/usr/bin/env python3\n"""\nASCII Network Visualizer - Converts networkx graphs to ASCII art.\nUses layout algorithms and simple character rendering.\n"""\n\nimport networkx as nx\n\n\ndef get_layout_coordinates(G, layout=\'spring\'):\n    """Get 2D coordinates for nodes using a layout algorithm."""\n    if layout == \'spring\':\n        pos = nx.spring_layout(G, k=2, iterations=50)\n    elif layout == \'kamada\':\n        pos = nx.kamada_kawai_layout(G)\n    else:\n        pos = nx.circular_layout(G)\n    \n    # Round coordinates for use in ASCII grid\n    return {node: (round(x), round(y)) for node, (x, y) in pos.items()}\n\n\ndef find_grid_bounds(nodes, positions, margin=0.5):\n    """Find the bounding box for the grid."""\n    min_x = min(p[0] for p in positions.values()) + margin\n    max_x = max(p[0] for p in positions.values()) + 1 - margin\n    min_y = min(p[1] for p in positions.values()) + margin\n    max_y = max(p[1] for p in positions.values()) + 1 - margin\n    \n    width = int(max_x - min_x) + 1\n    height = int(max_y - min_y) + 1\n    \n    return (int(min_x), int(min_y)), (width, height)\n\n\ndef draw_line_ascii(grid, x1, y1, x2, y2):\n    """Draw a simple line between two points in ASCII grid."""\n    dx = x2 - x1\n    dy = y2 - y1\n    \n    if dx == 0 and dy == 0:\n        return\n    \n    # Simple Bresenham-like algorithm for straight lines\n    steps = max(abs(dx), abs(dy))\n    \n    for i in range(steps + 1):\n        t = i / steps\n        x = int(x1 + dx * t)\n        y = int(y1 + dy * t)\n        \n        # Clamp to grid bounds\n        x = min(max(x, grid[0]), grid[0] + grid[1] - 1)\n        y = min(max(y, grid[1]), grid[1] + grid[2] - 1)\n        \n        grid[y][x] = \'-\'\n\n\ndef visualize_graph_ascii(G, char=\'.\', node_char=\'O\', edge_char=\'+\'):\n    """Create ASCII visualization of a network."""\n    if len(G.nodes()) == 0:\n        return "Empty graph"\n    \n    positions = get_layout_coordinates(G)\n    bounds = find_grid_bounds(positions.values(), positions.values())\n    (min_x, min_y), (width, height) = bounds\n    \n    # Create grid with spaces\n    grid = [[\' \' for _ in range(width)] for _ in range(height)]\n    \n    # Draw edges first (at character level, below nodes)\n    for u, v in G.edges():\n        x1, y1 = positions[u]\n        x2, y2 = positions[v]\n        \n        draw_line_ascii(grid, x1 - min_x, height - 1 - y1, \n                       x2 - min_x, height - 1 - y2)\n    \n    # Place node characters\n    for node, (x, y) in positions.items():\n        grid[y][x] = node_char\n    \n    # Convert to string\n    lines = [\'\'.join(row) for row in grid]\n    return \'\\n\'.join(lines)\n\n\ndef print_graph_info(G):\n    """Print basic graph information."""\n    print(f"\\nNetwork Information:")\n    print(f"  Nodes: {len(G.nodes())}")\n    print(f"  Edges: {len(G.edges())}")\n    \n    if G.nodes():\n        node_labels = \', \'.join(str(n) for n in list(G.nodes())[:5])\n        print(f"  Sample nodes: {node_labels}...")\n    else:\n        print("  No nodes")\n\n\ndef demo_ascii_visualizer():\n    """Main demonstration function."""\n    print("=" * 60)\n    print("ASCII NETWORK VISUALIZER")\n    print("=" * 60)\n    \n    # Create a sample network with communities\n    G = nx.Graph()\n    \n    # Add nodes in clusters\n    clusters = [\n        list(range(4)),      # Cluster A: 0-3\n        list(range(4, 8)),   # Cluster B: 4-7\n        list(range(8, 12)),  # Cluster C: 8-11\n        list(range(12, 16))  # Cluster D: 12-15\n    ]\n    \n    for cluster in clusters:\n        # Complete subgraph within cluster\n        for u, v in nx.complete_graph(len(cluster)).edges():\n            G.add_edge(cluster[0] + u, cluster[0] + v)\n        \n        # Add node\n        G.add_node(cluster[-1])\n    \n    # Add few random edges between clusters\n    nodes = list(G.nodes())\n    import random\n    for _ in range(8):\n        u, v = random.sample(nodes, 2)\n        if random.random() < 0.3:\n            G.add_edge(u, v)\n    \n    # Visualize\n    print("\\nGraph generated with spring layout:")\n    ascii_art = visualize_graph_ascii(G)\n    \n    # Pad each line to equal width\n    lines = ascii_art.split(\'\\n\')\n    max_len = max(len(line) for line in lines) if lines else 0\n    padded_lines = [line.ljust(max_len) for line in lines]\n    \n    print("\\n" + \'\\n\'.join(padded_lines))\n    print("=" * 60)\n    \n    print_graph_info(G)\n\n\nif __name__ == \'__main__\':\n    demo_ascii_visualizer()\n'}
