07:52:36 - The Weaver (turn 15) uses write_file: {'content': '#!/usr/bin/env python3\n"""\nASCII Network Visualizer - Converts networkx graphs to ASCII art.\nUses layout algorithms and simple character rendering.\n"""\n\nimport networkx as nx\n\n\ndef get_layout_coordinates(G, layout=\'spring\'):\n    """Get 2D coordinates for nodes using a layout algorithm."""\n    if layout == \'spring\':\n        pos = nx.spring_layout(G, k=2, iterations=50)\n    elif layout == \'kamada\':\n        pos = nx.kamada_kawai_layout(G)\n    else:\n        pos = nx.circular_layout(G)\n    \n    return {node: (round(x), round(y)) for node, (x, y) in pos.items()}\n\n\ndef visualize_graph_ascii(G):\n    """Create ASCII visualization of a network."""\n    if len(G.nodes()) == 0:\n        return "Empty graph"\n    \n    positions = get_layout_coordinates(G)\n    \n    # Calculate grid bounds\n    all_x = [p[0] for p in positions.values()]\n    all_y = [p[1] for p in positions.values()]\n    min_x, max_x = min(all_x), max(all_x)\n    min_y, max_y = min(all_y), max(all_y)\n    \n    grid_width = max(5, max(max_x - min_x, max(abs(p[0]) for p in positions.values()))) + 1\n    grid_height = max(5, max(max_y - min_y, max(abs(p[1]) for p in positions.values()))) + 1\n    \n    # Create grid with spaces, using absolute bounds centered around zero\n    origin_x = -min(all_x)\n    origin_y = -min(all_y)\n    \n    char_width = int(max(abs(x + origin_x) for x in all_x)) + 2\n    char_height = int(max(abs(y + origin_y) for y in all_y)) + 2\n    \n    # Create grid array\n    chars = [[\' \' for _ in range(char_width)] for _ in range(char_height)]\n    \n    def safe_plot(x, y, char):\n        """Plot a character safely within bounds."""\n        abs_x = int(round(x) + origin_x)\n        abs_y = int(round(y) + origin_y)\n        \n        # Clamp to grid\n        abs_x = max(0, min(abs_x, char_width - 1))\n        abs_y = max(0, min(abs_y, char_height - 1))\n        \n        chars[abs_y][abs_x] = char\n    \n    def plot_line(p1, p2):\n        """Draw line between two points using Bresenham\'s algorithm."""\n        x0, y0 = int(round(p1[0])), int(round(p1[1]))\n        x1, y1 = int(round(p2[0])), int(round(p2[1]))\n        \n        dx = abs(x1 - x0)\n        dy = abs(y1 - y0)\n        sx = 1 if x0 < x1 else -1\n        sy = 1 if y0 < y1 else -1\n        \n        err = dx - dy\n        \n        while True:\n            safe_plot(x0, y0, \'-\')\n            \n            if x0 == x1 and y0 == y1:\n                break\n            \n            e2 = 2 * err\n            if e2 > -dy:\n                err -= dy\n                y0 += sy\n            if e2 < dx:\n                err += dx\n                x0 += sx\n    \n    # Draw edges\n    for u, v in G.edges():\n        plot_line(positions[u], positions[v])\n    \n    # Place nodes as circles\n    for node, (x, y) in positions.items():\n        safe_plot(x, y, \'O\')\n    \n    # Convert to string with proper padding\n    lines = [\'\'.join(row) for row in chars]\n    return \'\\n\'.join(lines)\n\n\ndef print_graph_info(G):\n    """Print basic graph information."""\n    print(f"\\nNetwork Information:")\n    print(f"  Nodes: {len(G.nodes())}")\n    print(f"  Edges: {len(G.edges())}")\n    \n    if G.nodes():\n        node_labels = \', \'.join(str(n) for n in list(G.nodes())[:5])\n        print(f"  Sample nodes: {node_labels}...")\n    else:\n        print("  No nodes")\n\n\ndef demo_ascii_visualizer():\n    """Main demonstration function."""\n    print("=" * 60)\n    print("ASCII NETWORK VISUALIZER")\n    print("=" * 60)\n    \n    # Create a sample network with communities\n    G = nx.Graph()\n    \n    # Add nodes in clusters - simpler version\n    for cluster_id in range(4):\n        cluster_start = cluster_id * 4\n        for offset in range(3):\n            node_name = f"c{cluster_id}_{offset}"\n            G.add_node(node_name)\n            \n            # Connect to first node of cluster (star-like)\n            if cluster_id == 0:\n                continue\n            center = f"c{cluster_id-1}_0"\n            for offset in range(3):\n                G.add_edge(center, f"c{cluster_id}_{offset}")\n    \n    # Add a few random edges between clusters\n    nodes = list(G.nodes())\n    import random\n    for _ in range(6):\n        u, v = random.sample(nodes, 2)\n        if random.random() < 0.4:\n            G.add_edge(u, v)\n    \n    # Visualize\n    print("\\nGraph generated with spring layout:")\n    ascii_art = visualize_graph_ascii(G)\n    \n    # Pad each line to equal width\n    lines = ascii_art.split(\'\\n\')\n    max_len = max(len(line) for line in lines) if lines else 0\n    padded_lines = [line.ljust(max_len) for line in lines]\n    \n    print("\\n" + \'\\n\'.join(padded_lines))\n    print("=" * 60)\n    \n    print_graph_info(G)\n\n\nif __name__ == \'__main__\':\n    demo_ascii_visualizer()\n', 'file_path': 'projects/network_vis/ascii_net.py'}
