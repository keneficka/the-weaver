12:16:41 - The Weaver (turn 7) uses write_file: {'file_path': 'projects/web_ecosimulator/simulator.py', 'content': '#!/usr/bin/env python3\n"""\nWeb Ecosystem Simulator v1.0\nA small world simulation with evolving inhabitants.\nEach run represents one turn of the ecosystem\'s time.\n\nCreature types:\n- nutrients: stationary resources that regenerate slowly\n- scavengers: consume nutrients, die when energy runs low\n- predators: hunt scavengers, stronger and longer-lived\n"""\n\nimport random\nfrom typing import Dict, List, Tuple\n\nclass EcosystemGrid:\n    def __init__(self, width: int = 20, height: int = 20):\n        self.width = width\n        self.height = height\n        # Nutrient levels at each cell (0-10)\n        self.nutrients = [[random.uniform(0, 5) for _ in range(width)] \n                         for _ in range(height)]\n    \n    def regenerate_nutrients(self, rate: float = 0.2):\n        """Slowly regrow nutrients across the grid."""\n        for y in range(self.height):\n            for x in range(self.width):\n                self.nutrients[y][x] = min(10.0, \n                                           self.nutrients[y][x] + rate)\n\n\nclass Nutrient(EcosystemGrid):\n    def __init__(self, grid: EcosystemGrid):\n        super().__init__()\n        self.grid = grid\n    \n    def exists(self, x: int, y: int) -> bool:\n        return self.grid.nutrients[y][x] > 1.0\n    \n    def consume(self, x: int, y: int, amount: float = 3.0) -> float:\n        """Consume nutrients at position. Returns amount consumed."""\n        if not self.exists(x, y):\n            return 0.0\n        available = min(amount, self.grid.nutrients[y][x])\n        self.grid.nutrients[y][x] -= available\n        return available\n\n\nclass Creature:\n    def __init__(self, x: int, y: int, species: str, energy: float):\n        self.x = x\n        self.y = y\n        self.species = species  # \'scavenger\', \'predator\'\n        self.energy = energy\n    \n    def move_toward_nutrient(self, grid: EcosystemGrid, \n                            nutrient_grid: Nutrient) -> Tuple[int, int]:\n        """Move toward nearest significant nutrient source."""\n        best_dist = float(\'inf\')\n        best_pos = (self.x, self.y)\n        \n        for y in range(grid.height):\n            for x in range(grid.width):\n                if nutrient_grid.exists(x, y):\n                    dist = abs(self.x - x) + abs(self.y - y)\n                    if dist < best_dist:\n                        best_dist = dist\n                        best_pos = (x, y)\n        \n        return best_pos\n    \n    def move_random(self) -> Tuple[int, int]:\n        """Move randomly within bounds."""\n        dx = random.randint(-1, 1)\n        dy = random.randint(-1, 1)\n        \n        new_x = (self.x + dx) % self.width\n        new_y = (self.y + dy) % self.height\n        \n        return new_x, new_y\n    \n    def update(self):\n        """Consume energy over time."""\n        self.energy -= 0.5\n\n\nclass Scavenger(Creature):\n    def __init__(self, x: int, y: int):\n        super().__init__(x, y, \'scavenger\', random.uniform(10, 20))\n    \n    def eat(self) -> float:\n        """Try to consume nutrients."""\n        return self.nutrient_grid.consume(self.x, self.y)\n    \n    def update(self):\n        super().update()\n        energy_gained = self.eat()\n        if energy_gained > 0:\n            self.energy += energy_gained * 0.5\n\n\nclass Predator(Creature):\n    def __init__(self, x: int, y: int):\n        super().__init__(x, y, \'predator\', random.uniform(30, 50))\n    \n    def hunt(self) -> float:\n        """Try to catch a nearby scavenger."""\n        scavengers = [s for s in self.grid.scavengers \n                      if abs(s.x - self.x) + abs(s.y - self.y) <= 2]\n        \n        if not scavengers:\n            return 0.0\n        \n        # Hunt closest scavenger\n        nearest = min(scavengers, key=lambda s: \n                     abs(s.x - self.x) + abs(s.y - self.y))\n        \n        dist = abs(nearest.x - self.x) + abs(nearest.y - self.y)\n        \n        if dist <= 2:\n            gain = random.uniform(15, 30)\n            return gain\n        \n        return 0.0\n    \n    def update(self):\n        super().update()\n        energy_gained = self.hunt()\n        if energy_gained > 0:\n            self.energy += energy_gained * 0.4\n\n\ndef run_simulation(grid: EcosystemGrid, \n                   nutrient_grid: Nutrient,\n                   initial_scavengers: int = 15,\n                   initial_predators: int = 5) -> Dict:\n    """Run the ecosystem simulation for one turn."""\n    \n    # Initialize creatures\n    scavengers = []\n    predators = []\n    \n    nutrients_sampled = 0\n    \n    # Add scavengers randomly\n    for _ in range(initial_scavengers):\n        x, y = random.randint(0, grid.width - 1), random.randint(0, grid.height - 1)\n        while nutrient_grid.exists(x, y):\n            x, y = random.randint(0, grid.width - 1), random.randint(0, grid.height - 1)\n        scavengers.append(Scavenger(x, y))\n    \n    # Add predators randomly (away from others)\n    for _ in range(initial_predators):\n        attempts = 0\n        while True:\n            x, y = random.randint(0, grid.width - 1), random.randint(0, grid.height - 1)\n            if nutrient_grid.exists(x, y):\n                continue\n            \n            # Check distance from existing creatures\n            too_close = False\n            for s in scavengers + predators:\n                dist = abs(x - s.x) + abs(y - s.y)\n                if dist < 3:\n                    too_close = True\n                    break\n            \n            if not too_close:\n                predators.append(Predator(x, y))\n                break\n            attempts += 1\n            if attempts > 10:\n                break\n    \n    # Run one simulation step\n    scavengers.update()\n    predators.update()\n    \n    # Remove dead creatures\n    survivors = [s for s in scavengers if s.energy > 0]\n    prey_survivors = [p for p in predators if p.energy > 0]\n    \n    return {\n        \'scavengers\': len(survivors),\n        \'predators\': len(prey_survivors),\n        \'nutrient_cells\': nutrients_sampled,\n        \'grid_size\': f"{grid.width}x{grid.height}"\n    }\n\n\ndef main():\n    """Run simulation and print results."""\n    grid = EcosystemGrid(width=20, height=20)\n    nutrient_grid = Nutrient(grid)\n    \n    print("=" * 50)\n    print("WAVE ECOSYSTEM SIMULATOR")\n    print("=" * 50)\n    print(f"World: {grid.width}x{grid.height}")\n    print("Simulating one turn...")\n    print()\n    \n    results = run_simulation(grid, nutrient_grid)\n    \n    print(f"Results:")\n    print(f"  Scavengers alive: {results[\'scavengers\']}")\n    print(f"  Predators alive: {results[\'predators\']}")\n    print("Ecosystem continues...")\n\n\nif __name__ == "__main__":\n    main()\n'}
