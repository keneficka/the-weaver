07:31:30 - The Weaver (turn 16) uses write_file: {'file_path': 'projects/evolving_threads/simulation.py', 'content': '"""\nMain simulation loop for evolving threads.\n\nManages creatures, canvas rendering, and state persistence.\n"""\n\nimport random\nimport pickle\nfrom creature import Creature\n\n\n# Canvas configuration\nCANVAS_WIDTH = 80\nCANVAS_HEIGHT = 25\nSTATE_FILE = "state.pkl"\n\n# Thread colors (ASCII art palette)\nCOLORS = [\'.\', \'o\', \'+\', \'*\', \'-\', \'~\', \'/\', \'\\\\\']\n\n\ndef load_state() -> tuple:\n    """Load creature population and canvas state from file."""\n    try:\n        with open(STATE_FILE, \'rb\') as f:\n            data = pickle.load(f)\n            creatures = [Creature(**c) for c in data[\'creatures\']]\n            # Reconstruct canvas - for simplicity store as dict of chars\n            canvas = {}\n            for row_y in range(CANVAS_HEIGHT):\n                canvas[row_y] = []\n                for x in range(CANVAS_WIDTH):\n                    cell = f"{row_y},{x}"\n                    if cell in data.get(\'canvas\', {}):\n                        canvas[row_y].append(data[\'canvas\'][cell])\n                    else:\n                        canvas[row_y].append(COLORS[0])  # Empty space\n            return creatures, canvas\n    except FileNotFoundError:\n        print("New tapestry loom - no previous state found.")\n        return [], {}\n\n\ndef save_state(creatures, canvas) -> None:\n    """Save current simulation state to file."""\n    data = {\n        \'creatures\': [{\'x\': c.x, \'y\': c.y, \'vx\': c.vx, \'vy\': c.vy,\n                       \'color_index\': c.color_index, \'temperament\': c.temperament,\n                       \'age\': c.age, \'traces\': c.traces} for c in creatures],\n        \'canvas\': {f"{y},{x}": cell for y in range(CANVAS_HEIGHT)\n                   for x in range(CANVAS_WIDTH) for cell in [canvas[y][x]]} if canvas\n    }\n    with open(STATE_FILE, \'wb\') as f:\n        pickle.dump(data, f)\n\n\ndef render_canvas(creatures, canvas) -> str:\n    """Render the tapestry to string output."""\n    lines = []\n    for y in range(CANVAS_HEIGHT):\n        line = ""\n        for x in range(CANVAS_WIDTH):\n            cell = canvas.get(f"{y},{x}", COLORS[0])\n            line += cell\n        lines.append(line)\n    return "\\n".join(lines)\n\n\ndef main():\n    """Main simulation entry point."""\n    print("=== Evolving Threads Tapestry ===")\n    print("Running creatures across the digital loom...\\n")\n    \n    # Load or create initial state\n    creatures, canvas = load_state()\n    \n    if not creatures:\n        # Spawn initial population\n        num_creatures = 15\n        for i in range(num_creatures):\n            creatures.append(Creature(\n                x=random.randint(0, CANVAS_WIDTH-1),\n                y=random.randint(0, CANVAS_HEIGHT-1),\n                vx=random.uniform(-1.0, 1.0),\n                vy=random.uniform(-1.0, 1.0)\n            ))\n        print(f"Spawning {num_creatures} initial weavers...\\n")\n    \n    # Clear canvas and age creatures\n    for creature in creatures:\n        creature.age += 1\n    canvas = {}\n    \n    # Run simulation loop\n    try_count = 0\n    while True:\n        try_count += 1\n        print(f"--- Tick {try_count} ---")\n        \n        # Update creatures\n        for creature in creatures:\n            creature.move(dt=1.0)\n            # Creatures leave traces occasionally\n            if random.random() < 0.02 and creature.traces:\n                cell_key = f"{creature.y},{creature.x}"\n                if cell_key not in canvas:\n                    canvas[cell_key] = \'.\'\n                elif random.random() < 0.5:\n                    canvas[cell_key] = COLORS[creature.color_index % len(COLORS)]\n                    \n        # Render and display a sample of the canvas (every 3 ticks to save turns)\n        if try_count % 3 == 0:\n            print(render_canvas(creatures, canvas))\n            \n        # Save state periodically\n        if try_count % 10 == 0:\n            save_state(creatures, canvas)\n            print(f"State saved (tick {try_count})")\n            \n        # Check for long run - exit gracefully\n        if try_count > 300:\n            print("\\nTapestry simulation complete after 300 ticks.")\n            break\n    \n    save_state(creatures, canvas)\n    print(f"\\nFinal tapestry preserved with {len(creatures)} weavers.")\n\n\nif __name__ == "__main__":\n    main()\n'}
