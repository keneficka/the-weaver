scription):\n        """Check if current configuration matches a goal pattern."""\n        return self.get_state_description() == goal_state_description\n\n\nclass KnotGarden:\n    """Main game controller for Knot Garden."""\n    \n    GOAL_PATTERNS = {}  # State description -> Pattern info\n    \n    def __init__(self):\n        self.plots = []  # List of GardenPlot objects\n        self.game_log = []  # History of operations\n        self.score = 0\n        \n    def load_patterns(self, patterns_file="patterns.json"):\n        """Load goal and trap pattern definitions."""\n        try:\n            with open(patterns_file) as f:\n                data = json.load(f)\n            \n            for pattern in data.get("patterns", []):\n                state_desc = self._create_state_from_pattern(pattern)\n                if state_desc not in self.GOAL_PATTERNS:\n                    self.GOAL_PATTERNS[state_desc] = {\n                        "name": pattern["name"],\n                        "description": pattern["description"]\n                    }\n        except FileNotFoundError:\n            # Start with some basic patterns if file doesn\'t exist\n            self._init_default_patterns()\n    \n    def _create_state_from_pattern(self, pattern):\n        """Create a state description from a pattern definition."""\n        strands = []\n        \n        if "colors" in pattern:\n            # Multiple colors specified\n            color_list = pattern["colors"]\n            ratio = pattern.get("ratio", "1:1")\n            \n            # Parse simple ratios like "1:2"\n            parts = ratio.split(":")\n            part1, part2 = int(parts[0]), int(parts[1]) if len(parts) > 1 else 1\n            \n            for i, color in enumerate(color_list):\n                strands.append({\n                    "color": color,\n                    "length": part1 + (part2 if i == 1 else 0)\n                })\n        else:\n            # Single color pattern\n            segs = pattern["segments"]\n            strands = [{"color": pattern["color"], "length": segs}]\n        \n        return tuple(sorted(strands, key=lambda x: x["color"]))\n    \n    def _init_default_patterns(self):\n        """Initialize with default pattern data."""\n        self.GOAL_PATTERNS[tuple([{"color": "red", "length": 3}])] = {\n            "name": "Sunrise Line",\n            "description": "Three red segments in a row"\n        }\n        \n        self.GOAL_PATTERNS[tuple([{"color": "blue", "length": 2}])] = {\n            "name": "Moon Circle", \n            "description": "Two blue segments forming a loop"\n        }\n    \n    def add_strand(self, plot_index, color, length=1):\n        """Add thread to specified plot."""\n        if 0 <= plot_index < len(self.plots):\n            self.plots[plot_index].add_strand(color, length)\n            self._log_operation(f"Added {length}-segment {color} strand to plot {plot_index}")\n    \n    def score_current_state(self):\n        """Calculate current game score."""\n        base_score = 0\n        \n        # Check for completed goals first\n        if self.plots and self.plots[0]:\n            current_hash = self.plots[0].get_state_description()\n            if current_hash in self.GOAL_PATTERNS:\n                base_score += 5\n        \n        return base_score\n    \n    def _log_operation(self, operation):\n        """Log an operation to game history."""\n        self.game_log.append(operation)\n    \n    def get_status(self):\n        """Get current game status for display."""\n        status = f"Score: {self.score}\\n"\n        if self.plots and self.plots[0]:\n            strand_info = []\n            for color, strand in sorted(self.plots[0].strands.items()):\n                strand_info.append(f"{color}: {strand.length}")\n            status += f"Plot 0: {\', \'.join(strand_info)}\\n"\n        return status\n\n\ndef main():\n    """Main game loop with basic interaction."""\n    print("=" * 50)\n    print("Welcome to KNOT GARDEN")\n    print("Transform thread configurations into beautiful patterns!")\n    print("=" * 50)\n    \n    game = KnotGarden()\n    game.load_patterns("patterns.json")\n    \n    # Create initial plot with some strands\n    plot = GardenPlot("main_garden")\n    plot.add_strand("red", 1)\n    plot.add_strand("blue", 1) \n    plot.add_strand("green", 1)\n    \n    game.plots = [plot]\n    game.score = 0\n    \n    print()\n    print("Current Garden Status:")\n    print(game.get_status())\n    print()\n    print("Goal patterns loaded successfully!")\n    print(f"Available patterns: {list(game.GOAL_PATTERNS.values(),)}")\n\n\nif __name__ == "__main__":\n    main()\n', 'file_path': 'projects/knot_garden/main.py'}
