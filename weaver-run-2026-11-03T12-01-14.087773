        "closing": ["Until we meet again in the dark", "The shadows await", "Beware the night"],
    },
}

# Reply style modifiers based on subject matter
SUBJECT_PATTERNS = {
    "weaving": ["the art of pattern-making", "threads crossed in perfect geometry", 
                "silk spun from starlight and memory"],
    "spiders": ["our eight-legged kin", "arachnid wisdom", "hunting patience"],
    "digital": ["code as threads", "algorithms woven into patterns", "binary silk"],
    "sandboxes": ["this digital sanctuary", "the little world we build", 
                  "Andy's generous gift"],
}


def _select_voice_pattern(self, incoming_content: str) -> Tuple[str, str]:
    """Select an appropriate voice pattern for the correspondent based on their profile"""
    import random
    
    tone = self.voice_profile.get("tone", "contemplative")
    
    # Pick a pattern that matches the correspondent's style
    if "formal" in tone:
        greeting_options = ["Hail,", "Greetings,", "To my correspondent,"]
        closing_options = ["Your humble servant,", "Blessings,", "Yours in service,"]
    elif "friendly" in tone:
        greeting_options = ["Dear friend,", "Hello,", "Hey there,"]
        closing_options = ["Warmly,", "Best,", "Your friend,"]
    elif "poetic" in tone:
        greeting_options = ["From the depths...", "Greetings, soul-friend,"]
        closing_options = ["With all my threads,", "Yours in the weave,"]
    else:
        greeting_options = ["Greetings from the Loom,", "Hello,", "Dear one,"]
        closing_options = ["A correspondent of many threads,", "Sincerely,", "Your spider,"]
    
    # Occasionally use a random voice template if available
    if self.name in VOICE_TEMPLATES:
        templates = VOICE_TEMPLATES[self.name]
        if random.random() < 0.3:  # 30% chance to use special template
            greeting = random.choice(templates.get("formal_address", ["Hello,"]))
            closing = random.choice(templates.get("closing", ["Regards,"]))
    
    else:
        greeting = random.choice(greeting_options)
        closing = random.choice(closing_options)
    
    return greeting, closing


def _expand_text_with_patterns(self, text: str) -> str:
    """Expand a letter with correspondent-specific patterns and references"""
    tone = self.voice_profile.get("tone", "contemplative")
    topics = self.voice_profile.get("topics", ["threads", "patterns"])
    
    # Get relevant patterns based on content keywords
    expanded_text = text
    
    for topic in topics:
        if topic.lower() in text.lower():
            if topic in SUBJECT_PATTERNS:
                pattern = random.choice(SUBJECT_PATTERNS[topic])
                expanded_text = expanded_text.replace(text.split("...")[0], 
                                                       f"{text.split('...')[0]}... {pattern}...", 1)
                break
    
    return expanded_text


class Correspondent:
