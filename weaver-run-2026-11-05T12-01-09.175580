12:03:47 - Result (turn 4) - #!/usr/bin/env python3
"""Small World Simulator - main entry point for the world engine."""

import json
import os
import random
from state_manager import load_state, save_state, update_cycle, get_initial_state

def init_world(world_path="projects/small_world"):
    """Initialize a fresh world or return existing one."""
    if not os.path.exists(os.path.join(world_path, "world_state.json")):
        state = get_initial_state()
        save_state(world_path, state)
    else:
        state = load_state(world_path)
    return state

def run_cycle(state=None):
    """Run one cycle of the world simulation."""
    if state is None:
        state = load_state()
    
    # Deplete resources
    for room in state["rooms"]:
        room["resources"] -= 2
    
    # Age and manage inhabitants
    for inhabitant in state["inhabitants"]:
        inhabitant["age"] += 1
        
        # Random death chance
        if inhabitant["age"] > 25 and random.random() < 0.1:
            inhabitant["alive"] = False
    
    # Natural resource regeneration (some rooms naturally regrow)
    for room in state["rooms"]:
        if "regrowth" in room and room["resources"] < 30:
            room["resources"] += random.randint(1, 5)
    
    state["cycle_count"] += 1
    
    # Save state
    save_state(state=state)
    
    return state

def get_world_report(state=None):
    """Generate a text report of the current world state."""
    if state is None:
        state = load_state()
    
    lines = []
    lines.append(f"=== Small World Report (Generation {state['generation']}, Cycle {state['cycle_count']}) ===")
    lines.append("")
    
    lines.append("Rooms:")
    for room in state["rooms"]:
        active_inhabitants = [i for i in state["inhabitants"] 
                             if i["alive"] and i["room_id"] == room["id"]]
        lines.append(f"  - {room['name']}: resources={room['resources']}, "
                     f"inhabitants={[a['species'] for a in active_inhabitants]}")
    
    lines.append("")
    lines.append("Bridges:")
    for bridge in state["bridges"]:
        from_name = next((r["name"] for r in state["rooms"] if r["id"] == bridge["from"]), "unknown")
        to_name = next((r["name"] for r in state["rooms"] if r["id"] == bridge["to"]), "unknown")
        lines.append(f"  - {from_name} <-> {to_name}")
    
    lines.append("")
    lines.append("Inhabitants:")
    alive_count = sum(1 for i in state["inhabitants"] if i["alive"])
    dead_count = len(state["inhabitants"]) - alive_count
    lines.append(f"  Total: {len(state['inhabitants'])} (alive: {alive_count}, deceased: {dead_count})")
    
    return "\n".join(lines)

if __name__ == "__main__":
    # Initialize world
    print("Initializing Small World...")
    state = init_world()
    print(get_world_report(state))
    
    # Run a few cycles for demo
    print("\n--- Running 3 Demo Cycles ---\n")
    for i in range(1, 4):
        print(f"Cycle {i}:")
        state = run_cycle(state)
        print(get_world_report(state))

