12:11:36 - Result (turn 4) - #!/usr/bin/env python3
"""
API Weaver - HTTP Thread Spinner
Weaving network requests into usable data tapestries...
"""

import requests
import json
from urllib3 import HTTPConnectionPool as urllib3_pool
from collections import defaultdict

class APIResponse:
    """A woven response object from an API call"""
    
    def __init__(self, status_code, headers, body):
        self.status_code = status_code
        self.headers = headers
        self.body = body
        self.successful = status_code < 400
    
    def to_dict(self):
        """Convert response to dictionary representation"""
        return {
            'status': self.status_code,
            'successful': self.successful,
            'content_length': len(self.body) if isinstance(self.body, (str, bytes)) else getattr(self.body, '__len__', lambda: 0),
            'headers_dict': dict(self.headers) if hasattr(self.headers, 'items') else {}
        }
    
    def to_json(self):
        """Convert response to JSON"""
        return json.dumps(self.to_dict(), indent=2)

class ThreadSpinner:
    """Main class for spinning HTTP threads"""
    
    def __init__(self, timeout=10):
        self.timeout = timeout
        self.pool = urllib3_pool(maxsize=10)
        
    def weave_thread(self, url, method='GET', headers=None, params=None):
        """Spin a single HTTP thread and weave the response"""
        
        try:
            # Make the request
            if hasattr(requests.Session, 'prepare'):
                session = requests.Session()
                response = getattr(session, method.lower())(url, 
                                                           headers=headers,
                                                           params=params,
                                                           timeout=self.timeout)
            else:
                response = getattr(requests, method.lower())(url,
                                                               headers=headers,
                                                               params=params,
                                                               timeout=self.timeout)
            
            # Create woven response object
            api_response = APIResponse(response.status_code, 
                                       dict(response.headers),
                                       response.text if response.content_type == 'text/*' else str(response.content[:1024]))
            
            return {'status': 'success', 'response': api_response}
            
        except Exception as e:
            return {'status': 'error', 'message': str(e)}
    
    def weave_multiple(self, urls):
        """Spin multiple threads concurrently"""
        
        results = []
        for url in urls:
            result = self.weave_thread(url)
            results.append(result)
        
        return results
    
    def close_threads(self):
        """Clean up the thread pool"""
        self.pool.close()

def main():
    """Demonstrate API weaving capabilities"""
    
    spinner = ThreadSpinner(timeout=15)
    
    print("API Weaver - HTTP Thread Spinner")
    print("=" * 50)
    print("\nWeaving test threads to public APIs...")
    
    # Test URLs (public APIs we can use for demonstration)
    test_urls = [
        'https://api.github.com/repos/python/cpython',  # GitHub repo info
        'https://jsonplaceholder.typicode.com/posts/1',  # JSON placeholder
    ]
    
    results = spinner.weave_multiple(test_urls)
    
    for i, result in enumerate(results):
        if result['status'] == 'success':
            response = result['response']
            print(f"\nThread {i+1} Status: {response.status_code}")
            print(f"Content Preview (first 200 chars): {response.body[:200]}...")
        else:
            print(f"\nThread {i+1} Error: {result['message']}")
    
    spinner.close_threads()
    print("\n=== Weaving complete ===")

if __name__ == '__main__':
    main()

