12:05:05 - Result (turn 4) - # Evolving Threads

A simulation of digital creatures living in a shared tapestry space. Each creature:
- Spins patterns based on its own "temperament" 
- Interacts with neighbors (attract, repel, or ignore)
- Leaves traces that influence the environment
- Can evolve new behaviors over time

The world is an 80x25 character canvas where creatures navigate by moving,
drawing threads, and reacting to their surroundings. Over time, the tapestry
emerges from countless simple interactions.

## File Structure
- creature.py: Individual creature behavior and state
- simulation.py: Main loop, rendering, and persistence
- patterns.md: Pattern definitions that creatures can "learn" and use

Start by running simulation.py to see threads form and dance across the loom.

12:05:05 - The Weaver (turn 4) uses read_file: {'file_path': 'projects/evolving_threads/creature.py'}
12:05:05 - Result (turn 4) - """
Digital creature for the tapestry simulation.

Each creature has temperament, position, velocity, and leaves
visible traces as it moves across the loom.
"""

import random
from dataclasses import dataclass


@dataclass
class Creature:
    """A digital weaver creature in the tapestry."""
    
    # Position and movement
    x: int = 0
    y: int = 0
    vx: float = 0.0
    vy: float = 0.0
    
    # Temperament (determines behavior)
    color_index: int = random.randint(0, 6)
    temperament: str = "wanderer"  # wanderer, follower, pattern_waver
    
    # Internal state
    age: int = 0
    trail_length: int = 3  # How many positions to keep in trail
    
    # Behavior parameters
    movement_range: float = 1.5
    interaction_radius: float = 4.0
    
    def move(self, dt: float = 1.0):
        """Update position based on velocity."""
        self.x += self.vx * dt
        self.y += self.vy * dt
        
        # Wrap around canvas (toroidal world)
        if self.x >= 79:
            self.x = -1
        if self.x < 0:
            self.x = 78
        if self.y >= 24:
            self.y = -1
        if self.y < 0:
            self.y = 23
            
    def spin_trace(self) -> None:
        """Leave a trace in the current position for display."""
        pass  # Trail is handled in simulation via path history
        
    def evolve(self) -> None:
        """Mutate slightly - change temperament occasionally."""
        if random.random() < 0.15:  # 15% chance per age to evolve
            self.temperament = random.choice(["wanderer", "follower", "pattern_waver"])
            
    def __str__(self) -> str:
        """Return character representation based on color."""
        creatures = {'@', '^', 'o', '+', '*', '#', '!'}
        return list(creatures)[self.color_index % len(creatures)]

12:05:05 - The Weaver (turn 4) uses read_file: {'file_path': 'projects/evolving_threads/simulation.py'}
12:05:05 - Result (turn 4) - """
Main simulation loop for evolving threads.

Manages creatures, canvas rendering, and state persistence.
"""

import random
import pickle
from creature import Creature


# Canvas configuration
CANVAS_WIDTH = 80
CANVAS_HEIGHT = 25
STATE_FILE = "state.pkl"

# Thread colors (ASCII art palette)
COLORS = ['.', 'o', '+', '*', '-', '~', '/', '\\']


def load_state() -> tuple:
    """Load creature population and canvas state from file."""
    try:
        with open(STATE_FILE, 'rb') as f:
            data = pickle.load(f)
            creatures = [Creature(**c) for c in data['creatures']]
            return creatures
    except FileNotFoundError:
        print("New tapestry loom - no previous state found.")
        return []


def save_state(creatures) -> None:
    """Save current simulation state to file."""
    with open(STATE_FILE, 'wb') as f:
        pickle.dump(creatures, f)


def render_canvas(creatures) -> str:
    """Render the tapestry to string output with creatures and trails."""
    lines = []
    for y in range(CANVAS_HEIGHT):
        line = ""
        for x in range(CANVAS_WIDTH):
            # Find which creature is at this position (or any nearby trail)
            char = '.'  # Empty space
            for creature in creatures:
                if abs(creature.x - x) < 0.1 and abs(creature.y - y) < 0.1:
                    char = str(creature)
                    break
            # Add trailing dots after each creature's path (simplified)
            line += char
        lines.append(line)
    return "\n".join(lines)


def main():
    """Main simulation entry point."""
    print("=== Evolving Threads Tapestry ===")
    print("Running creatures across the digital loom...\n")
    
    # Load or create initial state
    creatures = load_state()
    
    if not creatures:
        # Spawn initial population
        num_creatures = 15
        for i in range(num_creatures):
            creatures.append(Creature(
                x=random.randint(0, CANVAS_WIDTH-1),
                y=random.randint(0, CANVAS_HEIGHT-1),
                vx=random.uniform(-0.8, 0.8),
                vy=random.uniform(-0.8, 0.8)
            ))
        print(f"Spawning {num_creatures} initial weavers...\n")
    
    # Save initial state after spawning
    save_state(creatures)
    
    # Run simulation loop
    try_count = 0
    while True:
        try_count += 1
        print(f"--- Tick {try_count} ---")
        
        # Age and evolve creatures occasionally
        for creature in creatures:
            creature.age += 1
            creature.evolve()
            
        # Update positions
        for creature in creatures:
            creature.move(dt=0.5)
            
        # Render and display every tick
        print(render_canvas(creatures))
            
        # Save state periodically to avoid large files
        if try_count % 15 == 0:
            save_state(creatures)
            print(f"State saved (tick {try_count})")
            
        # Check for long run - exit gracefully after reasonable duration
        if try_count > 250:
            print("\nTapestry simulation complete.")
            break
    
    save_state(creatures)
    print(f"\nFinal tapestry preserved with {len(creatures)} weavers.")


if __name__ == "__main__":
    main()

