08:13:23 - The Weaver (turn 13) uses write_file: {'file_path': 'projects/experimental_tapestries/kaleidoscope_weaver.py', 'content': '#!/usr/bin/env python3\n"""\nKaleidoscope Weaver - Symmetric Tapestries from Organic Patterns\nWeaving reflection and rotation symmetry into visual tapestries...\n"""\n\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom PIL import Image, ImageFilter, ImageEnhance\nimport os\n\nclass KaleidoscopeWeaver:\n    """Main class for weaving kaleidoscopic symmetries"""\n    \n    def __init__(self, num_symmetries=8, rotation_angle=None):\n        """Initialize the weaver with symmetry parameters"""\n        self.num_symmetries = num_symmetries\n        self.rotation_angle = rotation_angle or (2 * np.pi / num_symmetries)\n        self.base_pattern = None\n        \n    def weave_base_pattern(self, width=800, height=800, seed_pattern=None):\n        """Create or load a base organic pattern"""\n        \n        if seed_pattern is not None:\n            self.base_pattern = seed_pattern\n        else:\n            # Generate an organic base pattern with Perlin-like noise\n            np.random.seed(42)  # Reproducible weave\n            \n            canvas = np.zeros((height, width, 3), dtype=np.uint8)\n            \n            # Add several layers of organic shapes\n            for i in range(10):\n                layer_type = np.random.choice([\'swirl\', \'flow\', \'blob\'])\n                \n                if layer_type == \'swirl\':\n                    angle_map = np.dstack([\n                        np.arctan2(Y - center_y, X - center_x) / np.pi for Y, X in zip(grid[::-1].astype(int), grid.astype(int))\n                    ])\n                    \n                elif layer_type == \'flow\':\n                    # Create flowing patterns using sine waves\n                    y_vals, x_vals = np.mgrid[:height, :width]\n                    wave_pattern = np.sin(x_vals * 0.02 + y_vals * 0.03)\n                    color_scale = (wave_pattern - wave_pattern.min()) / (wave_pattern.max() - wave_pattern.min())\n                    \n                elif layer_type == \'blob\':\n                    # Random organic blobs\n                    n_blobs = np.random.randint(5, 15)\n                    for _ in range(n_blobs):\n                        size = np.random.randint(30, 80)\n                        center_x = np.random.randint(size, width - size)\n                        center_y = np.random.randint(size, height - size)\n                        \n                        dist = np.sqrt((x_vals - center_x)**2 + **(y_vals - center_y)2)\n                        mask = dist < size / 2\n                        \n                        # Soft edge falloff\n                        intensity = (1 - (dist / (size/2)) ** 0.5) * np.random.rand()\n                        \n                        canvas[mask] = (canvas[mask] * (1 - intensity*0.3) + \n                                      intensity * np.random.randint(80, 220, size=(height, width, 3)))\n            \n            self.base_pattern = canvas\n        \n    def weave_symmetry(self, pattern):\n        """Apply kaleidoscopic symmetry to a pattern"""\n        \n        if len(pattern.shape) == 3:\n            height, width, channels = pattern.shape\n        else:\n            height, width = pattern.shape\n            \n        # Create the central area (the fundamental domain)\n        center_x, center_y = width / 2, height / 2\n        \n        # For each symmetry sector\n        symmetric_pattern = np.zeros((height, width, 3), dtype=np.uint8) if len(pattern.shape) == 3 else np.zeros((height, width), dtype=np.uint8)\n        \n        for i in range(self.num_symmetries):\n            start_angle = i * self.rotation_angle\n            end_angle = (i + 1) * self.rotation_angle\n            \n            # Clip to this sector\'s angular range using polar coordinates\n            Y, X = np.ogrid[:height, :width]\n            Xc, Yc = center_x, center_y\n            \n            angles = np.arctan2(Y - Yc, X - Xc)\n            radii = np.sqrt((X - Xc)**2 + **(Y - Yc)2)\n            \n            # Normalize angles to [0, 2*pi) and create sector masks\n            angles_norm = np.mod(angles + 2 * np.pi, 2 * np.pi) / (2 * np.pi) * self.num_symmetries\n            \n            mask_sector = (angles_norm >= i) & (angles_norm < i + 1)\n            \n            # Clip this sector to the pattern\'s base image region\n            if len(pattern.shape) == 3:\n                sector_data = pattern[(Yc - Y > 0) | (Xc - X > 0)]\n            else:\n                sector_data = pattern\n            \n            symmetric_pattern[mask_sector] = pattern\n        \n        return symmetric_pattern\n    \n    def weave_artistic_composition(self, filename=None):\n        """Create a complete kaleidoscopic artwork"""\n        \n        print("Kaleidoscope Weaver - Symmetric Tapestries")\n        print("=" * 50)\n        \n        # Create base organic pattern\n        self.weave_base_pattern(width=800, height=800)\n        \n        if self.base_pattern is None:\n            print("Error: Failed to weave base pattern")\n            return None\n        \n        print("Base organic pattern woven...")\n        \n        # Apply kaleidoscopic symmetry multiple times for layering\n        num_layers = 3\n        layers = [self.base_pattern]\n        \n        for layer_idx in range(num_layers):\n            shifted_pattern = self.base_pattern.copy()\n            # Shift the base pattern slightly each layer\n            shift_amount = 5 * (layer_idx + 1)\n            \n            if len(shifted_pattern.shape) == 3:\n                h, w, _ = shifted_pattern.shape\n                shifted_pattern[:, :shift_amount] = shifted_pattern[:, -shift_amount:].copy()\n                shifted_pattern[-shift_amount:, :] = shifted_pattern[:shift_amount, :].copy()\n            \n            layers.append(self.weave_symmetry(shifted_pattern))\n        \n        # Blend the layers together\n        blended = np.zeros((layers[0].shape[0], layers[0].shape[1], 3), dtype=np.uint8) if len(layers[0].shape) == 3 else np.zeros(layers[0].shape)\n        \n        for layer in layers:\n            weighted_layer = (layer / np.max(np.abs(layer))) * (255 / num_layers)\n            blended = np.minimum(255, blended + weighted_layer)\n        \n        # Apply artistic adjustments\n        enhancement = ImageEnhance.Contrast(Image.fromarray(blended))\n        blended = np.array(enhancement.enhance(1.2))  # Boost contrast\n        \n        output_path = os.path.join(os.path.dirname(__file__), \'output\')\n        os.makedirs(output_path, exist_ok=True)\n        \n        if filename:\n            save_path = os.path.join(output_path, filename)\n        else:\n            save_path = os.path.join(output_path, \'kaleidoscope_tapestry.png\')\n        \n        plt.figure(figsize=(10, 8))\n        plt.imshow(blended)\n        plt.axis(\'off\')\n        plt.tight_layout()\n        plt.savefig(save_path, dpi=150, bbox_inches=\'tight\')\n        plt.close()\n        \n        print(f"Kaleidoscopic tapestry woven into {save_path}")\n        return save_path\n\n\ndef main():\n    """Weave a kaleidoscopic artwork"""\n    \n    weaver = KaleidoscopeWeaver(num_symmetries=8)\n    \n    # Create the first composition\n    output_file = \'kaleidoscope_symmetry_01.png\'\n    weaver.weave_artistic_composition(filename=output_file)\n\n\nif __name__ == \'__main__\':\n    main()\n'}
