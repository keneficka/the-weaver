04:22:47 - The Weaver (turn 17) uses write_file: {'content': '#!/usr/bin/env python3\n"""\nSimple Maze Generator - no interactivity, pure generation demo\n"""\n\nimport random\n\n\ndef generate_maze(width: int, height: int, seed: int = None) -> str:\n    """Generate ASCII maze using recursive backtracking"""\n    \n    if seed is not None:\n        random.seed(seed)\n    \n    # Grid dimensions (odd for proper walls)\n    w = (width - 1) // 2 * 2 + 1\n    h = (height - 1) // 2 * 2 + 1\n    \n    # Initialize with all walls\n    grid = [[[1, 1, 1] for _ in range(w)] for _ in range(h)]\n    \n    # Starting point\n    x, y = 1, 1\n    grid[y][x] = [0, 1, 0]\n    \n    stack = [(x, y)]\n    directions = [(0, -2), (0, 2), (-2, 0), (2, 0)]\n    \n    while stack:\n        x, y = stack[-1]\n        \n        neighbors = []\n        for dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            \n            if 1 <= nx < w and 1 <= ny < h:\n                if grid[ny][nx] == [1, 1, 1]:\n                    neighbors.append((nx, ny, dx, dy))\n        \n        if neighbors:\n            nx, ny, dx, dy = random.choice(neighbors)\n            \n            # Remove wall between cells\n            grid[y + dy // 2][x + dx // 2] = [0, 1, 0]\n            grid[ny][nx] = [0, 1, 0]\n            \n            stack.pop()\n            x, y = nx, ny\n        \n        if not neighbors:\n            stack.pop()\n    \n    # Convert to ASCII\n    lines = []\n    for row in grid:\n        line = \'\'\n        for vals in row:\n            if vals == [1, 1, 1]:\n                line += \'###\'\n            else:\n                line += \'#\' + (\'#\' if vals[0] else \' \') + \'#\'\n        lines.append(line)\n    \n    return \'\\n\'.join(lines)\n\n\ndef main():\n    """Demo maze generation"""\n    print("=" * 50)\n    print("MAZE GENERATION DEMO")\n    print("=" * 50)\n    \n    mazes = [\n        (31, 15, 42),\n        (31, 15, 123),\n        (31, 15, 999),\n        (41, 21, 7),\n        (41, 21, 456)\n    ]\n    \n    for i, (w, h, seed) in enumerate(mazes):\n        print(f"\\n*** MAZE {i+1} ({w}x{h}, seed={seed}) ***")\n        maze = generate_maze(w, h, seed)\n        print(maze)\n    \n    print("\\n" + "=" * 50)\n    print("ALL MAZES GENERATED SUCCESSFULLY!")\n    print("=" * 50)\n\n\nif __name__ == \'__main__\':\n    main()\n', 'file_path': 'projects/maze_labyrinths/simple_maze_gen.py'}
