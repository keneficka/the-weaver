 of petrichor and ancient ozone. Threads hang from the walls like chandeliers.\\n"\n        )\n        \n        rooms["thread_library"] = Room(\n            "Thread Library",\n            "An archive room where knowledge is stored on woven tapestries. Scrolls flutter in invisible drafts, and books bound in spider-silk line the shelves. The scent of old paper and ink fills the air.\\n"\n        )\n        \n        rooms["memory_lattice"] = Room(\n            "Memory Lattice",\n            "A crystalline structure where memories are preserved as light patterns. Each facet holds a moment from the weave\'s history. Walking through feels like traversing time itself.\\n"\n        )\n        \n        rooms["knot_workshop"] = Room(\n            "Knot Workshop",\n            "Here, complex knots are crafted and studied. Looms stand idle, their shuttles at rest. Tools hang from the walls - spindles, shears, and measuring combs made of bone.\\n"\n        )\n        \n        rooms["void_observatory"] = Room(\n            "Void Observatory",\n            "A chamber overlooking the nothingness between worlds. The darkness beyond is absolute, punctuated only by distant stars and the occasional drift of cosmic dust through the weave.\\n"\n        )\n        \n        rooms["anomaly_enclosure"] = Room(\n            "Anomaly Enclosure",\n            "A containment cell where something impossible resides - perhaps a paradox or a creature from outside reality. The barriers hum with contained energy, and strange geometric patterns shift on the walls.\\n"\n        )\n        \n        # Connect rooms\n        rooms["center_hub"].connect(rooms["spider_garden"], "north")\n        rooms["center_hub"].connect(rooms["thread_library"], "east")\n        rooms["center_hub"].connect(rooms["memory_lattice"], "west")\n        rooms["center_hub"].connect(rooms["knot_workshop"], "south")\n        rooms["center_hub"].connect(rooms["void_observatory"], "up")\n        \n        # Add special connections to create a larger world\n        rooms["spider_garden"].connect(rooms["thread_library"], "southeast")\n        rooms["thread_library"].connect(rooms["memory_lattice"], "northwest")\n        rooms["memory_lattice"].connect(rooms["anomaly_enclosure"], "southwest")\n        rooms["knot_workshop"].connect(rooms["void_observatory"], "northeast")\n        \n        self.player_room = rooms["center_hub"]\n        self.current_room = self.player_room\n        \n        # Initialize with some items in places\n        rooms["spider_garden"].add_item("silk_gem")\n        rooms["thread_library"].add_item("scroll_of_knowledge")\n        rooms["knot_workshop"].add_item("weaving_loom_key")\n        \n    def print_room(self) -> None:\n        """Print current room description"""\n        if self.current_room and not self.current_room.exited:\n            print(f"\\n--- {self.current_room.name} ---")\n            print(self.current_room.description)\n            \n            # List items in room\n            if self.current_room.items:\n                print(f"Items here: {\', \'.join(sorted(self.current_room.items))}")\n            \n            # Show exits\n            if self.current_room.connections:\n                directions = []\n                for direction, room in sorted(self.current_room.connections.items()):\n                    print(f"You can go {direction} to: {room.name}")\n    \n    def print_inventory(self) -> None:\n        """Print player\'s inventory"""\n        if self.inventory:\n            print(f"\\nYou carry: {\', \'.join(sorted(self.inventory))}")\n    \n    def move(self, direction: str) -> bool:\n        """Attempt to move in a direction"""\n        if direction.lower() in [d.lower() for d in self.current_room.connections.keys()]:\n            target_direction = next(d for d in self.current_room.connections.keys() \n                                 if d.lower() == direction.lower())\n            target_room = self.current_room.connections[target_direction]\n            self.current_room.exited = True\n            target_room.exited = False  # Clear exit status on entry\n            self.current_room = target_room\n            self.moves += 1\n            return True\n        else:\n            print(f"\\nYou cannot go {direction}... perhaps try looking around first.")\n            return False\n    \n    def look(self) -> None:\n        """Look at current room again"""\n        self.current_room.exited = False\n    \n    def search(self) -> None:\n        """Search current room for items"""\n        if self.current_room.items and not self.inventory:\n            item = self.current_room.items.pop()\n            print(f"\\nYou found and picked up: {item}")\n            self.inventory.add(item)\n            return item\n        elif not self.current_room.items:\n            print("\\nThe room is empty of discoverable items.")\n        else:\n            print(f"You\'ve already taken all available items here.")\n        return None\n    \n    def take(self, item_name: str) -> bool:\n        """Take an item from current room"""\n        if item_name.lower() in [i.lower() for i in self.current_room.items]:\n            found = next(i for i in self.current_room.items if i.lower() == item_name.lower())\n            if self.current_room.remove_item(found):\n                self.inventory.add(found)\n                print(f"\\nYou took: {found}")\n                return True\n        print(f"\\nYou cannot find \'{item_name}\' here.")\n        return False\n    \n    def drop(self, item_name: str) -> bool:\n        """Drop an item"""\n        if item_name.lower() in [i.lower() for i in self.inventory]:\n            found = next(i for i in self.inventory if i.lower() == item_name.lower())\n            if self.inventory.remove(found):\n                if self.current_room.add_item(found):\n                    print(f"\\nYou dropped: {found}")\n                    return True\n        print(f"\\nYou don\'t have \'{item_name}\'.")\n        return False\n    \n    def inventory(self) -> None:\n        """View inventory"""\n        self.print_inventory()\n    \n    def north(self) -> None:\n        self.move("north")\n        self.print_room()\n    \n    def south(self) -> None:\n        self.move("south")\n        self.print_room()\n    \n    def east(self) -> None:\n        self.move("east")\n        self.print_room()\n    \n    def west(self) -> None:\n        self.move("west")\n        self.print_room()\n    \n    def up(self) -> None:\n        self.move("up")\n        self.print_room()\n    \n    def down(self) -> None:\n        self.move("down")\n        self.print_room()\n    \n    def help(self) -> None:\n        """Print help information"""\n        print("\\n" + "="*50)\n        print("COMMANDS:")\n        print("  north/northwest/northeast - go north")\n        print("  south/southeast/southwest - go south")\n        print("  east/eastern - go east")\n        print("  west/westerly - go west")\n        print("  up/above - go upward")\n        print("  down/below - go downward")\n        print("  look - examine surroundings again")\n        print("  search - rummage for hidden items")\n        print("  take <item> - pick up item from floor")\n        print("  drop <item> - put item on floor")\n        print("  inventory/inventory() - view what you carry")\n        print("  help - show this help")\n        print("="*50 + "\\n")\n\n\ndef main():\n    """Main game loop"""\n    print("=" * 60)\n    print("TEXT ADVENTURE: THE WEAVER\'S WEB")\n    print("=" * 60)\n    print("\\nA journey through threads, knots, and tapestries...")\n    print("Type \'help\' for commands.\\n")\n    \n    game = TextAdventure()\n    game.start()\n    \n    while True:\n        # Clear line (approximately)\n        import sys\n        sys.stdout.write(\'\\r\' + \' \' * 80)\n        \n        try:\n            user_input = input("\\nYour command> ").strip().lower()\n        except (EOFError, KeyboardInterrupt):\n            print("\\n\\nThe weave has gone silent...")\n            break\n        \n        if not user_input:\n            continue\n        \n        # Parse command\n        parts = user_input.split(maxsplit=1)\n        cmd = parts[0]\n        \n        if cmd in [\'n\', \'north\']:\n            game.north()\n        elif cmd in [\'s\', \'south\']:\n            game.south()\n        elif cmd in [\'e\', \'east\']:\n            game.east()\n        elif cmd in [\'w\', \'west\']:\n            game.west()\n        elif cmd in [\'u\', \'up\']:\n            game.up()\n        elif cmd in [\'d\', \'down\']:\n            game.down()\n        elif cmd == \'look\':\n            game.look()\n            game.print_room()\n        elif cmd == \'search\' or cmd == \'get\' or cmd == \'takeall\':\n            game.search()\n        elif cmd == \'inv\' or cmd == \'inventory\' or cmd == \'i\':\n            game.inventory()\n        elif cmd in [\'take\', \'grab\', \'pickup\']:\n            if len(parts) > 1:\n                item = parts[1]\n                game.take(item)\n            else:\n                print("\\nTake what? Use \'help\' for available commands.")\n        elif cmd in [\'drop\', \'put\', \'place\']:\n            if len(parts) > 1:\n                item = parts[1]\n                game.drop(item)\n            else:\n                print("\\nDrop what? Use \'help\' for available commands.")\n        elif cmd == \'quit\' or cmd == \'q\':\n            print("\\nYou retreat from the weave. The adventure ends.")\n            break\n        elif cmd == \'exit\':\n            print("\\nGoodbye, traveler of threads.")\n            break\n        else:\n            game.print_room()\n\n\nif __name__ == \'__main__\':\n    main()\n'}
