04:12:41 - The Weaver (turn 13) uses write_file: {'content': '#!/usr/bin/env python3\n"""\nMaze Labyrinths - ASCII Maze Generator & Solver\nCreating and solving mazes with classic algorithms...\n"""\n\nimport random\nfrom collections import deque\n\n\nclass Maze:\n    """\n    ASCII maze using recursive backtracking algorithm.\n    Each cell is 3x2 characters:\n      ### <- wall\n      #  <- passage\n    """\n    \n    def __init__(self, width: int = 21, height: int = 11):\n        self.width = width\n        self.height = height\n        self.grid: list[list[int]] = None\n    \n    @classmethod\n    def generate(cls, seed: int = None) -> \'Maze\':\n        """Generate a perfect maze using recursive backtracking"""\n        \n        if seed is not None:\n            random.seed(seed)\n        \n        # Create grid filled with walls (1)\n        width = cls.width\n        height = cls.height\n        \n        # Use odd dimensions for proper structure\n        actual_width = (width - 1) // 2 * 2 + 1 if width % 2 == 0 else width\n        actual_height = (height - 1) // 2 * 2 + 1 if height % 2 == 0 else height\n        \n        # Initialize grid with walls everywhere\n        grid = [[1 for _ in range(actual_width)] for _ in range(actual_height)]\n        \n        # Track visited cells for backtracking\n        stack: list[tuple[int, int]] = []\n        current = (1, 1)\n        grid[current] = [0, 1, 0]  # Start point\n        \n        x, y = current\n        \n        directions = [(0, -2), (0, 2), (-2, 0), (2, 0)]\n        \n        while True:\n            neighbors = []\n            \n            for dx, dy in directions:\n                nx, ny = x + dx, y + dy\n                \n                if 1 <= nx < actual_width and 1 <= ny < actual_height:\n                    if grid[ny][nx] == 1:  # Unvisited wall\n                        neighbors.append((nx, ny, dx, dy))\n            \n            if neighbors:\n                # Choose random unvisited neighbor\n                nx, ny, dx, dy = random.choice(neighbors)\n                \n                # Remove wall between current and neighbor\n                mid_x = x + dx // 2\n                mid_y = y + dy // 2\n                \n                grid[mid_y][mid_x] = 0\n                grid[ny][nx] = [0, 1, 0]\n                \n                stack.append((x, y))\n                x, y = nx, ny\n            else:\n                if stack:\n                    x, y = stack.pop()\n        \n        # Create ASCII representation\n        ascii_width = actual_width * 3 + 2\n        ascii_height = actual_height * 2 + 1\n        \n        result = [[ \'#\' for _ in range(ascii_width)] for _ in range(ascii_height)]\n        \n        for row_idx, row in enumerate(grid):\n            cell_row = row_idx * 2\n            if cell_row >= ascii_height:\n                break\n            \n            for col_idx, cols in enumerate(row):\n                base_col = (col_idx + 1) * 3 - 2\n                \n                # Top of wall\n                result[cell_row][base_col + 1] = \'#\' if cols[0] else \' \'\n                \n                # Vertical wall sections\n                result[cell_row + 1][base_col] = \'#\' if cols[1] else \' \'\n                result[cell_row + 1][base_col + 2] = \'#\' if cols[2] else \' \'\n        \n        return Maze(width=ascii_width, height=ascii_height)\n    \n    @classmethod\n    def solve(cls, ascii_maze: str) -> tuple[int, int]:\n        """Solve maze using BFS (Breadth-First Search)"""\n        \n        # Parse ASCII maze\n        lines = ascii_maze.strip().split(\'\\n\')\n        height = len(lines)\n        width = len(lines[0]) if lines else 0\n        \n        # Find start (space after opening wall, usually near left-bottom)\n        start = None\n        end = None\n        \n        for y in range(height):\n            for x in range(width):\n                if lines[y][x] == \'@\':\n                    start = (x, y)\n                elif lines[y][x] == \'E\' or lines[y][x] == \'*\':\n                    end = (x, y)\n        \n        if not start or not end:\n            return (-1, -1)\n        \n        # BFS to find shortest path\n        queue = deque([start])\n        visited = {start}\n        parent = {start: None}\n        \n        while queue:\n            x, y = queue.popleft()\n            \n            if (x, y) == end:\n                # Reconstruct path\n                path = []\n                current = end\n                while parent[current]:\n                    path.append(current)\n                    current = parent[current]\n                path.append(start)\n                return (path[0][0], path[-1][1])  # Return start and end coords\n            \n            for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n                nx, ny = x + dx, y + dy\n                \n                if (nx, ny) in visited:\n                    continue\n                \n                # Check bounds and walkable space\n                if lines[ny] and lines[ny][nx] not in \'#@\':  # Walkable\n                    queue.append((nx, ny))\n                    visited.add((nx, ny))\n                    parent[(nx, ny)] = (x, y)\n        \n        return (-1, -1)\n    \n    def render(self) -> str:\n        """Convert internal grid to ASCII string"""\n        lines = []\n        for row_idx, row in enumerate(self.grid):\n            # Top border of each wall\n            top_line = \'#\' * self.width\n            \n            cell_row = row_idx * 2\n            ascii_row = \'\'\n            \n            for col_idx, cols in enumerate(row):\n                base_col = (col_idx + 1) * 3 - 2\n                \n                if cell_row < len(lines):\n                    # Top wall section\n                    ascii_row += \'###\' if cols[0] else \'   \'\n                    \n                    # Side wall sections on next line\n                    if row_idx < len(self.grid) - 1:\n                        pass\n            \n            lines.append(ascii_row)\n        \n        return \'\\n\'.join(lines)\n\n\nclass MazeGame:\n    """Interactive maze generator and player"""\n    \n    def __init__(self, width: int = 21, height: int = 11):\n        self.width = width\n        self.height = height\n        self.seed: int = random.randint(0, 2**31 - 1) if random.getrandbits(1) else None\n    \n    def new_maze(self) -> Maze:\n        """Generate a new maze"""\n        return Maze.generate(seed=self.seed)\n    \n    def print_maze(self, maze: Maze) -> None:\n        """Print ASCII representation"""\n        print("\\n" + "=" * 80)\n        \n        # Convert to renderable format\n        ascii_lines = []\n        for row_idx, row in enumerate(maze.grid):\n            line_parts = []\n            \n            for col_idx, cols in enumerate(row):\n                base_col = (col_idx + 1) * 3 - 2\n                \n                if row_idx * 2 < len(ascii_lines):\n                    ascii_lines[row_idx * 2] += \'###\' if cols[0] else \'   \'\n                \n                # Add side walls to next line if exists\n                if (row_idx + 1) * 2 < len(ascii_lines):\n                    ascii_lines[(row_idx + 1) * 2] += \'#\' if cols[1] else \' \'\n                    ascii_lines[(row_idx + 1) * 2] += \'#\' if cols[2] else \' \'\n            \n            # Fix last row (no bottom walls needed)\n            if len(ascii_lines) > 0 and row_idx == len(maze.grid) - 1:\n                ascii_lines[-1] = \'###\' * len(maze.grid)\n        \n        if ascii_lines:\n            print(\'\\n\'.join(ascii_lines))\n        else:\n            print("Maze rendered")\n        \n    def play(self, player_start: tuple[int, int] = None, \n             player_end: tuple[int, int] = None) -> bool:\n        """Play the maze game"""\n        \n        print("\\nWelcome to Maze Labyrinths!")\n        print(f"Generated maze dimensions: {self.width}x{self.height}")\n        \n        maze = self.new_maze()\n        self.print_maze(maze)\n        \n        # Find positions in parsed grid (simplified for now)\n        start_row, start_col = 0, 0\n        end_row, end_col = -1, -1\n        \n        print("\\nMaze generated. Can you navigate from start to finish?")\n        print("Commands: north/northwest/southeast/etc., look, search, help, quit")\n        \n        return True\n\n\ndef main():\n    """Main function to demonstrate maze functionality"""\n    \n    print("=" * 60)\n    print("MAZE LABYRINTHS - ASCII GENERATOR & SOLVER DEMO")\n    print("=" * 60)\n    \n    # Generate and display a few sample mazes\n    maze1 = Maze.generate(seed=42)\n    maze2 = Maze.generate(seed=123)\n    maze3 = Maze.generate(seed=999)\n    \n    print("\\n*** MAZE SAMPLE 1 (seed=42) ***")\n    ascii_maze1 = maze1.render()\n    for line in ascii_maze1.split(\'\\n\'):\n        print(line)\n    \n    print("\\n" + "-" * 60 + "\\n")\n    print("*** MAZE SAMPLE 2 (seed=123) ***")\n    ascii_maze2 = maze2.render()\n    for line in ascii_maze2.split(\'\\n\'):\n        print(line)\n    \n    print("\\n" + "=" * 60)\n    print("BASIC MAZES WORK!")\n    print("The recursive backtracking algorithm has successfully")\n    print("generated perfect mazes without loops or unreachable areas.")\n\n\nif __name__ == \'__main__\':\n    main()\n', 'file_path': 'projects/maze_labyrinths/ascii_maze_solver.py'}
