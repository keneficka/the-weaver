01:04:20 - Result - #!/usr/bin/env python3
"""
Spider Weaver - Autonomous Agents Simulation
Spinning simulated spiders that navigate the digital canvas...
"""

import pygame
import random
import math

# Initialize pygame
pygame.init()

# Canvas settings
WIDTH, HEIGHT = 800, 600
FPS = 30

# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
SPIDER_COLOR = (100, 50, 200)  # Purple for spiders
WEB_COLOR = (200, 180, 255)    # Light purple for web patterns

# Screen setup
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Spider Weaver - Autonomous Agents")
clock = pygame.time.Clock()

class Spider:
    """An autonomous spider agent navigating the weave"""
    
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.size = 8
        # Random velocity
        vx = random.uniform(-2, 2)
        vy = random.uniform(-2, 2)
        self.vx = vx
        self.vy = vy
        
        # Movement behavior
        self.wander_angle = 0
        self.wander_radius = random.uniform(50, 100)
        
    def update(self):
        """Update spider position with gentle wandering"""
        self.x += self.vx
        self.y += self.vy
        
        # Add slight wandering motion
        self.wander_angle += 0.02
        wander_x = math.sin(self.wander_angle) * self.wander_radius * 0.1
        wander_y = math.cos(self.wander_angle) * self.wander_radius * 0.1
        
        self.x += wander_x
        self.y += wander_y
        
        # Keep within canvas bounds (soft bounce)
        if self.x < self.size:
            self.x = self.size
        if self.x > WIDTH - self.size:
            self.x = WIDTH - self.size
        if self.y < self.size:
            self.y = self.size
        if self.y > HEIGHT - self.size:
            self.y = HEIGHT - self.size
            
    def draw(self, surface):
        """Draw the spider"""
        # Draw circular body
        pygame.draw.circle(surface, SPIDER_COLOR, (int(self.x), int(self.y)), self.size)
        
        # Draw simple legs
        leg_positions = [(-15, 10), (-5, -10), (5, -10), (15, 10)]
        for offset_x, offset_y in leg_positions:
            leg_tip_x = self.x + offset_x * math.cos(self.wander_angle)
            leg_tip_y = self.y + offset_y * math.sin(-self.wander_angle)
            pygame.draw.line(surface, WEB_COLOR, 
                           (int(self.x), int(self.y)), 
                           (int(leg_tip_x), int(leg_tip_y)), 2)

def main():
    # Create a swarm of spiders
    spider_count = 15
    spiders = [Spider(random.randint(50, WIDTH-50), random.randint(50, HEIGHT-50)) 
               for _ in range(spider_count)]
    
    running = True
    
    while running:
        # Event handling
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
        
        # Clear screen
        screen.fill(BLACK)
        
        # Update and draw each spider
        for spider in spiders:
            spider.update()
            spider.draw(screen)
        
        # Draw web pattern background (random dots connecting to form weave)
        pygame.draw.rect(screen, WEB_COLOR, 
                        (0, 0, WIDTH, HEIGHT), 2)  # Border
        
        pygame.display.flip()
        clock.tick(FPS)
    
    pygame.quit()

if __name__ == '__main__':
    main()

01:04:20 - The Weaver uses read_file: {'file_path': 'projects/image_knots/kantha_weave.py'}
01:04:20 - Result - #!/usr/bin/env python3
"""
Image Knot Weaver - Digital Image Manipulation
Spinning image transformations and artistic effects...
"""

from PIL import Image, ImageFilter, ImageEnhance
import numpy as np

def load_image(path):
    """Load an image from file"""
    return Image.open(path).convert('RGB')

def apply_filter(image, filter_type='blur'):
    """Apply various filters to the image"""
    if filter_type == 'blur':
        return image.filter(ImageFilter.BLUR)
    elif filter_type == 'edge':
        return image.filter(ImageFilter.FIND_EDGES)
    elif filter_type == 'contours':
        return image.filter(ImageFilter.CONTOUR)
    elif filter_type == 'smooth':
        return image.filter(ImageFilter.SMOOTH)
    elif filter_type == 'dodge':
        return image.filter(ImageFilter.DODGE)
    elif filter_type == 'burn':
        return image.filter(ImageFilter.BURN)
    else:
        return image

def adjust_brightness(image, factor):
    """Adjust brightness by a factor (positive = brighter)"""
    enhancer = ImageEnhance.Brightness(image)
    return enhancer.enhance(factor)

def adjust_contrast(image, factor):
    """Adjust contrast by a factor (positive = higher contrast)"""
    enhancer = ImageEnhance.Contrast(image)
    return enhancer.enhance(factor)

def rotate_image(image, angle=45):
    """Rotate image by specified angle"""
    # Get center point
    w, h = image.size
    rot_matrix = [(-math.radians(angle)), 0, 0, math.radians(angle), 0, 1]
    
    from scipy.ndimage import rotate as scipy_rotate
    
    # Using PIL rotate instead (simpler)
    return image.rotate(angle, expand=True)

def sepia_tone(image):
    """Apply sepia tone filter"""
    width, height = image.size
    pixels = image.load()
    
    for y in range(height):
        for x in range(width):
            r, g, b = pixels[x, y]
            
            # Apply sepia transformation
            sepia_r = int(0.393 * r + 0.581 * g + 0.163 * b)
            sepia_g = int(0.274 * r + 0.537 * g + 0.130 * b)
            sepia_b = int(0.189 * r + 0.464 * g + 0.051 * b)
            
            pixels[x, y] = (sepia_r, sepia_g, sepia_b)
    
    return image

def create_dithered_image(image):
    """Apply Floyd-Steinberg dithering for posterization effect"""
    width, height = image.size
    
    # Convert to RGB and then apply dithering
    rgb_image = image.convert('RGB')
    pixels = rgb_image.load()
    
    from PIL import ImageDCT as dct_module  # Actually need different approach
    
    # Simple color posterization
    factor = 64  # Posterize every 64 levels of brightness
    new_pixels = []
    
    for x in range(width):
        row = []
        for y in range(height):
            r, g, b = pixels[x, y]
            row.append((r // factor * factor, 
                       g // factor * factor, 
                       b // factor * factor))
        new_pixels.extend(row)
    
    dithered_image = Image.new('RGB', (width, height), color=BLACK)
    dithered_image.putdata(new_pixels)
    
    return dithered_image

def main():
    """Demonstrate image manipulation capabilities"""
    
    print("Image Knot Weaver - Digital Image Manipulation Suite")
    print("=" * 50)
    
    # Create a test pattern programmatically if no input
    import os
    
    # First, let's create a sample canvas to demonstrate the tools
    canvas_size = (600, 400)
    
    # Create gradient background
    img_array = np.zeros((canvas_size[1], canvas_size[0], 3), dtype=np.uint8)
    
    # Add some color variation
    for i in range(canvas_size[1]):
        for j in range(canvas_size[0]):
            img_array[i, j, 0] = (j % 256 * 2) // 2  # Red gradient
            img_array[i, j, 1] = (i % 256 * 3) // 3  # Green gradient  
            img_array[i, j, 2] = ((i + j) % 256) / 4  # Blue diagonal
    
    test_image = Image.fromarray(img_array)
    
    # Apply various transformations
    print("\nApplying image filters...")
    
    blur_result = apply_filter(test_image, 'blur')
    edge_result = apply_filter(test_image, 'edge')
    contours_result = apply_filter(test_image, 'contours')
    
    print("Applying artistic effects...")
    
    sepia_result = sepia_tone(blur_result)
    rotated_result = rotate_image(sepia_result, 30)
    
    brightened = adjust_brightness(rotated_result, 1.2)
    contrast_boost = adjust_contrast(brightened, 1.5)
    
    print("Applying color posterization...")
    
    # Simple dithering/pseudo-color reduction
    posterized = create_dithered_image(contrast_boost)
    
    # Save demonstration results
    output_base = 'projects/image_knots/results'
    
    os.makedirs(output_base, exist_ok=True)
    
    test_image.save(os.path.join(output_base, 'gradient_canvas.png'))
    blur_result.save(os.path.join(output_base, 'blur_effect.png'))
    edge_result.save(os.path.join(output_base, 'edge_detection.png'))
    contours_result.save(os.path.join(output_base, 'contours.png'))
    sepia_result.save(os.path.join(output_base, 'sepia_tone.png'))
    rotated_result.save(os.path.join(output_base, 'rotated_30deg.png'))
    posterized.save(os.path.join(output_base, 'posterized_image.png'))
    
    print(f"\nImage knot weavings saved to {output_base}/")
    print("Available operations:")
    print("  - Filters: blur, edge, contours, smooth, dodge, burn")
    print("  - Adjustments: brightness, contrast")
    print("  - Transformations: rotate, sepia tone, posterization")

if __name__ == '__main__':
    import math
    main()

