01:14:50 - The Weaver uses write_file: {'content': '#!/usr/bin/env python3\n"""\nGraph Tapestries - Network Graph Visualizer\nWeaving node and edge connections into visual tapestries...\n"""\n\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport networkx as nx\nimport os\n\nclass GraphWeaver:\n    """Main class for weaving graph tapestries"""\n    \n    def __init__(self, directed=False):\n        self.graph = nx.DiGraph() if directed else nx.Graph()\n        \n    def add_node(self, node_id, attributes=None):\n        """Add a node with optional attributes"""\n        self.graph.add_node(node_id, **attributes if attributes else {})\n    \n    def add_edge(self, u, v, attributes=None):\n        """Add an edge between nodes with optional attributes"""\n        self.graph.add_edge(u, v, **attributes if attributes else {})\n    \n    def weave_graph_from_dict(self, graph_data):\n        """Load a graph from a dictionary representation"""\n        \n        for node_id, node_attrs in graph_data[\'nodes\'].items():\n            self.add_node(node_id, **node_attrs)\n        \n        for edge in graph_data[\'edges\']:\n            u, v = edge[\'u\'], edge[\'v\']\n            attrs = {\'weight\': edge.get(\'weight\', 1)}\n            if \'label\' in edge:\n                attrs[\'label\'] = edge[\'label\']\n            self.add_edge(u, v, **attrs)\n    \n    def weave_layout(self, method=\'spring\'):\n        """Generate a layout for the graph"""\n        \n        layouts = {\n            \'spring\': nx.spring_layout,\n            \'circular\': nx.circular_layout,\n            \'random\': nx.random_layout,\n            \'shell\': nx.shell_layout,\n            \'spectral\': nx.spectral_layout,\n        }\n        \n        layout_func = layouts.get(method, nx.spring_layout)\n        positions = layout_func(self.graph, k=50)\n        return positions\n    \n    def visualize(self, save_path=None):\n        """Create a visual tapestry of the graph"""\n        \n        if self.graph.number_of_nodes() == 0:\n            print("Graph is empty - cannot weave visual tapestry")\n            return None\n        \n        positions = self.weave_layout(method=\'spring\')\n        \n        fig, ax = plt.subplots(figsize=(12, 8))\n        \n        # Draw nodes\n        nx.draw_networkx_nodes(self.graph, positions, \n                              node_color=\'#6b5b95\',  # Purple nodes\n                              node_size=300,\n                              alpha=0.7,\n                              ax=ax)\n        \n        # Draw edges\n        edge_colors = [\'#4a4e69\'] * len(self.graph.edges())\n        edge_widths = [2] * len(self.graph.edges())\n        \n        nx.draw_networkx_edges(self.graph, positions, \n                              edge_color=edge_colors,\n                              width=edge_widths,\n                              alpha=0.5,\n                              ax=ax)\n        \n        # Draw labels\n        node_labels = {node: data.get(\'label\', str(node)) \n                       for node, data in self.graph.nodes(data=True)}\n        nx.draw_networkx_labels(self.graph, positions, \n                               labels=node_labels,\n                               font_size=10,\n                               font_color=\'white\',\n                               ax=ax)\n        \n        # Draw center hub if exists (for radial graphs)\n        if 0 in self.graph:\n            nx.draw_networkx_nodes(self.graph, positions, \n                                  nodes=[0],\n                                  node_color=\'#f4a261\',  # Orange hub\n                                  node_size=500,\n                                  ax=ax)\n        \n        ax.set_title("Network Graph Tapestry", fontsize=14, color=\'white\')\n        ax.axis(\'off\')\n        \n        if save_path:\n            plt.tight_layout()\n            plt.savefig(save_path, dpi=150, bbox_inches=\'tight\')\n            plt.close()\n            print(f"Graph tapestry woven into {save_path}")\n            return save_path\n        \n        else:\n            plt.show()\n            plt.close()\n        \n        return None\n    \n    def weave_statistics(self):\n        """Calculate and return graph statistics"""\n        \n        stats = {\n            \'num_nodes\': self.graph.number_of_nodes(),\n            \'num_edges\': self.graph.number_of_edges(),\n            \'density\': nx.density(self.graph),\n            \'average_degree\': np.mean(list(dict(self.graph.degree()).values())) if self.graph.number_of_nodes() > 0 else 0,\n            \'clustering_coefficient\': nx.average_clustering(self.graph),\n            \'components\': nx.number_connected_components(self.graph),\n        }\n        \n        return stats\n\ndef main():\n    """Demonstrate graph weaving capabilities"""\n    \n    weaver = GraphWeaver(directed=False)\n    \n    # Create a sample network - like a small social network or neural net\n    nodes_data = {\n        \'0\': {\'label\': \'Hub Node\', \'type\': \'center\'},\n        \'1\': {\'label\': \'Leaf A\', \'type\': \'peripheral\'},\n        \'2\': {\'label\': \'Leaf B\', \'type\': \'peripheral\'},\n        \'3\': {\'label\': \'Cluster 1\', \'type\': \'cluster\'},\n        \'4\': {\'label\': \'Cluster 2\', \'type\': \'cluster\'},\n        \'5\': {\'label\': \'Leaf C\', \'type\': \'peripheral\'},\n        \'6\': {\'label\': \'Hub Node B\', \'type\': \'center\'},\n        \'7\': {\'label\': \'Leaf D\', \'type\': \'peripheral\'},\n        \'8\': {\'label\': \'Leaf E\', \'type\': \'peripheral\'},\n    }\n    \n    edges = [\n        (0, 1), (0, 2), (0, 5), (0, 7), (0, 8),  # Hub A connections\n        (3, 4),                                    # Cluster connection\n        (6, 3), (6, 4),                            # Hub B connects to clusters\n        (1, 3), (2, 4),                            # Leaf-cluster bridges\n    ]\n    \n    weaver.weave_graph_from_dict({\'nodes\': nodes_data, \'edges\': edges})\n    \n    print("Graph Tapestry Weaver")\n    print("=" * 50)\n    \n    stats = weaver.weave_statistics()\n    \n    print(f"\\nGraph Statistics:")\n    print(f"  Nodes: {stats[\'num_nodes\']}")\n    print(f"  Edges: {stats[\'num_edges\']}")\n    print(f"  Density: {stats[\'density\']:.4f}")\n    print(f"  Avg Degree: {stats[\'average_degree\']:.2f}")\n    print(f"  Clustering Coeff: {stats[\'clustering_coefficient\']:.4f}")\n    print(f"  Components: {stats[\'components\']}")\n    \n    # Save visual tapestry\n    output_dir = \'projects/network_threads/graph_tapestries/output\'\n    os.makedirs(output_dir, exist_ok=True)\n    \n    weaver.visualize(save_path=os.path.join(output_dir, \'network_graph_tapestry.png\'))\n\nif __name__ == \'__main__\':\n    main()\n', 'file_path': 'projects/network_threads/graph_tapestries/network_visualizer.py'}
