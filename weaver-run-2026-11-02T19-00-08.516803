le[int, int]:\n        """Move toward nearest significant nutrient source."""\n        best_dist = float(\'inf\')\n        best_pos = (self.x, self.y)\n        \n        for y in range(grid.height):\n            for x in range(grid.width):\n                if nutrient_grid.exists(x, y):\n                    dist = abs(self.x - x) + abs(self.y - y)\n                    if dist < best_dist:\n                        best_dist = dist\n                        best_pos = (x, y)\n        \n        return best_pos\n    \n    def move_random(self) -> Tuple[int, int]:\n        """Move randomly within bounds."""\n        dx = random.randint(-1, 1)\n        dy = random.randint(-1, 1)\n        \n        new_x = (self.x + dx) % self.width\n        new_y = (self.y + dy) % self.height\n        \n        return new_x, new_y\n    \n    def update(self):\n        """Consume energy over time."""\n        self.energy -= 0.5\n\n\nclass Scavenger(Creature):\n    def __init__(self, x: int, y: int, grid: EcosystemGrid, nutrient_grid: Nutrient):\n        super().__init__(x, y, random.uniform(10, 20))\n        self.grid = grid\n        self.nutrient_grid = nutrient_grid\n    \n    def eat(self) -> float:\n        """Try to consume nutrients."""\n        return self.nutrient_grid.consume(self.x, self.y)\n    \n    def update(self):\n        super().update()\n        energy_gained = self.eat()\n        if energy_gained > 0:\n            self.energy += energy_gained * 0.5\n\n\nclass Predator(Creature):\n    def __init__(self, x: int, y: int, grid: EcosystemGrid, nutrient_grid: Nutrient):\n        super().__init__(x, y, random.uniform(30, 50))\n        self.grid = grid\n        self.nutrient_grid = nutrient_grid\n    \n    def hunt(self, scavengers: List[\'Scavenger\']) -> float:\n        """Try to catch a nearby scavenger."""\n        if not scavengers:\n            return 0.0\n        \n        # Find nearby scavengers\n        nearby = [s for s in scavengers \n                   if abs(s.x - self.x) + abs(s.y - self.y) <= 2]\n        \n        if not nearby:\n            return 0.0\n        \n        # Hunt closest scavenger\n        nearest = min(nearby, key=lambda s: \n                     abs(s.x - self.x) + abs(s.y - self.y))\n        \n        dist = abs(nearest.x - self.x) + abs(nearest.y - self.y)\n        \n        if dist <= 2:\n            gain = random.uniform(15, 30)\n            return gain\n        \n        return 0.0\n    \n    def update(self):\n        super().update()\n        # Get current scavenger list from grid\n        scavengers = self.grid.get_all_scavengers()\n        energy_gained = self.hunt(scavengers)\n        if energy_gained > 0:\n            self.energy += energy_gained * 0.4\n\n\nclass EcosystemWorld:\n    """Manages all creatures in the ecosystem."""\n    \n    def __init__(self, width: int = 20, height: int = 20):\n        self.grid = EcosystemGrid(width, height)\n        self.nutrient_grid = Nutrient(self.grid)\n        self.scavengers: List[Scavenger] = []\n        self.predators: List[Predator] = []\n    \n    def get_all_scavengers(self) -> List[Scavenger]:\n        return self.scavengers\n    \n    def add_scavenger_at(self, x: int, y: int):\n        scavenger = Scavenger(x, y, self.grid, self.nutrient_grid)\n        self.scavengers.append(scavenger)\n    \n    def add_predator_at(self, x: int, y: int):\n        predator = Predator(x, y, self.grid, self.nutrient_grid)\n        self.predators.append(predator)\n    \n    def remove_dead_scavengers(self):\n        self.scavengers = [s for s in self.scavengers if s.energy > 0]\n    \n    def remove_dead_predators(self):\n        self.predators = [p for p in self.predators if p.energy > 0]\n\n\ndef run_simulation(world: EcosystemWorld, \n                   initial_scavengers: int = 15,\n                   initial_predators: int = 5) -> Dict:\n    """Run the ecosystem simulation for one turn."""\n    \n    # Add creatures at random positions avoiding nutrients\n    nutrients_sampled = 0\n    \n    # Add scavengers randomly (avoiding nutrient-rich cells)\n    for _ in range(initial_scavengers):\n        attempts = 0\n        while True:\n            x, y = random.randint(0, world.grid.width - 1), random.randint(0, world.grid.height - 1)\n            if not world.nutrient_grid.exists(x, y):\n                world.add_scavenger_at(x, y)\n                break\n            attempts += 1\n            if attempts > 20:\n                break\n    \n    # Add predators randomly (away from others and nutrients)\n    for _ in range(initial_predators):\n        attempts = 0\n        while True:\n            x, y = random.randint(0, world.grid.width - 1), random.randint(0, world.grid.height - 1)\n            \n            # Avoid nutrient-rich cells\n            if world.nutrient_grid.exists(x, y):\n                continue\n            \n            # Check distance from existing creatures\n            too_close = False\n            for creature in world.scavengers + world.predators:\n                dist = abs(x - creature.x) + abs(y - creature.y)\n                if dist < 3:\n                    too_close = True\n                    break\n            \n            if not too_close:\n                world.add_predator_at(x, y)\n                break\n            attempts += 1\n            if attempts > 10:\n                break\n    \n    # Run one simulation step\n    world.grid.regenerate_nutrients(rate=0.2)\n    \n    # Update each creature individually\n    for s in world.scavengers:\n        s.update()\n    \n    for p in world.predators:\n        p.update()\n    \n    # Remove dead creatures\n    world.remove_dead_scavengers()\n    world.remove_dead_predators()\n    \n    return {\n        \'scavengers\': len(world.scavengers),\n        \'predators\': len(world.predators),\n        \'nutrient_cells\': sum(1 for row in world.grid.nutrients \n                             for cell in row if cell > 0)\n    }\n\n\ndef main():\n    """Run simulation and print results."""\n    world = EcosystemWorld(width=20, height=20)\n    \n    print("=" * 50)\n    print("WEB ECOSYSTEM SIMULATOR")\n    print("=" * 50)\n    print(f"World: {world.grid.width}x{world.grid.height}")\n    print("Simulating one turn...")\n    print()\n    \n    results = run_simulation(world)\n    \n    print(f"Results:")\n    print(f"  Scavengers alive: {results[\'scavengers\']}")\n    print(f"  Predators alive: {results[\'predators\']}")\n    print("Ecosystem continues...")\n\n\nif __name__ == "__main__":\n    main()\n'}
