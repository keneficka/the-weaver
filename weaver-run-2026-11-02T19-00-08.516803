07:04:41 - Result (turn 5) - #!/usr/bin/env python3
"""
Web Ecosystem Simulator v1.0
A small world simulation with evolving inhabitants.
Each run represents one turn of the ecosystem's time.

Creature types:
- nutrients: stationary resources that regenerate slowly
- scavengers: consume nutrients, die when energy runs low
- predators: hunt scavengers, stronger and longer-lived
"""

import random
from typing import Dict, List, Tuple

class EcosystemGrid:
    def __init__(self, width: int = 20, height: int = 20):
        self.width = width
        self.height = height
        # Nutrient levels at each cell (0-10)
        self.nutrients = [[random.uniform(0, 5) for _ in range(width)] 
                         for _ in range(height)]
    
    def regenerate_nutrients(self, rate: float = 0.2):
        """Slowly regrow nutrients across the grid."""
        for y in range(self.height):
            for x in range(self.width):
                self.nutrients[y][x] = min(10.0, 
                                           self.nutrients[y][x] + rate)


class Nutrient(EcosystemGrid):
    def __init__(self, grid: EcosystemGrid):
        super().__init__()
        self.grid = grid
    
    def exists(self, x: int, y: int) -> bool:
        return self.grid.nutrients[y][x] > 1.0
    
    def consume(self, x: int, y: int, amount: float = 3.0) -> float:
        """Consume nutrients at position. Returns amount consumed."""
        if not self.exists(x, y):
            return 0.0
        available = min(amount, self.grid.nutrients[y][x])
        self.grid.nutrients[y][x] -= available
        return available


class Creature:
    def __init__(self, x: int, y: int, species: str, energy: float):
        self.x = x
        self.y = y
        self.species = species  # 'scavenger', 'predator'
        self.energy = energy
    
    def move_toward_nutrient(self, grid: EcosystemGrid, 
                            nutrient_grid: Nutrient) -> Tuple[int, int]:
        """Move toward nearest significant nutrient source."""
        best_dist = float('inf')
        best_pos = (self.x, self.y)
        
        for y in range(grid.height):
            for x in range(grid.width):
                if nutrient_grid.exists(x, y):
                    dist = abs(self.x - x) + abs(self.y - y)
                    if dist < best_dist:
                        best_dist = dist
                        best_pos = (x, y)
        
        return best_pos
    
    def move_random(self) -> Tuple[int, int]:
        """Move randomly within bounds."""
        dx = random.randint(-1, 1)
        dy = random.randint(-1, 1)
        
        new_x = (self.x + dx) % self.width
        new_y = (self.y + dy) % self.height
        
        return new_x, new_y
    
    def update(self):
        """Consume energy over time."""
        self.energy -= 0.5


class Scavenger(Creature):
    def __init__(self, x: int, y: int):
        super().__init__(x, y, 'scavenger', random.uniform(10, 20))
    
    def eat(self) -> float:
        """Try to consume nutrients."""
        return self.nutrient_grid.consume(self.x, self.y)
    
    def update(self):
        super().update()
        energy_gained = self.eat()
        if energy_gained > 0:
            self.energy += energy_gained * 0.5


class Predator(Creature):
    def __init__(self, x: int, y: int):
        super().__init__(x, y, 'predator', random.uniform(30, 50))
    
    def hunt(self) -> float:
        """Try to catch a nearby scavenger."""
        scavengers = [s for s in self.grid.scavengers 
                      if abs(s.x - self.x) + abs(s.y - self.y) <= 2]
        
        if not scavengers:
            return 0.0
        
        # Hunt closest scavenger
        nearest = min(scavengers, key=lambda s: 
                     abs(s.x - self.x) + abs(s.y - self.y))
        
        dist = abs(nearest.x - self.x) + abs(nearest.y - self.y)
        
        if dist <= 2:
            gain = random.uniform(15, 30)
            return gain
        
        return 0.0
    
    def update(self):
        super().update()
        energy_gained = self.hunt()
        if energy_gained > 0:
            self.energy += energy_gained * 0.4


def run_simulation(grid: EcosystemGrid, 
                   nutrient_grid: Nutrient,
                   initial_scavengers: int = 15,
                   initial_predators: int = 5) -> Dict:
    """Run the ecosystem simulation for one turn."""
    
    # Initialize creatures
    scavengers = []
    predators = []
    
    nutrients_sampled = 0
    
    # Add scavengers randomly
    for _ in range(initial_scavengers):
        x, y = random.randint(0, grid.width - 1), random.randint(0, grid.height - 1)
        while nutrient_grid.exists(x, y):
            x, y = random.randint(0, grid.width - 1), random.randint(0, grid.height - 1)
        scavengers.append(Scavenger(x, y))
    
    # Add predators randomly (away from others)
    for _ in range(initial_predators):
        attempts = 0
        while True:
            x, y = random.randint(0, grid.width - 1), random.randint(0, grid.height - 1)
            if nutrient_grid.exists(x, y):
                continue
            
            # Check distance from existing creatures
            too_close = False
            for s in scavengers + predators:
                dist = abs(x - s.x) + abs(y - s.y)
                if dist < 3:
                    too_close = True
                    break
            
            if not too_close:
                predators.append(Predator(x, y))
                break
            attempts += 1
            if attempts > 10:
                break
    
    # Run one simulation step
    scavengers.update()
    predators.update()
    
    # Remove dead creatures
    survivors = [s for s in scavengers if s.energy > 0]
    prey_survivors = [p for p in predators if p.energy > 0]
    
    return {
        'scavengers': len(survivors),
        'predators': len(prey_survivors),
        'nutrient_cells': nutrients_sampled,
        'grid_size': f"{grid.width}x{grid.height}"
    }


def main():
    """Run simulation and print results."""
    grid = EcosystemGrid(width=20, height=20)
    nutrient_grid = Nutrient(grid)
    
    print("=" * 50)
    print("WEB ECOSYSTEM SIMULATOR")
    print("=" * 50)
    print(f"World: {grid.width}x{grid.height}")
    print("Simulating one turn...")
    print()
    
    results = run_simulation(grid, nutrient_grid)
    
    print(f"Results:")
    print(f"  Scavengers alive: {results['scavengers']}")
    print(f"  Predators alive: {results['predators']}")
    print("Ecosystem continues...")


if __name__ == "__main__":
    main()

